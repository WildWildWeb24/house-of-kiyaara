{% comment %}
  This code generates the main media container that can be shown as slider or as a grid.

  Accepts:
  - product: {Object} The product object (required/template access)
  - aspect_ratio: {String} The aspect ratio of the media. Default: 'natural' (optional)
  - sizing_rule: {String} 'cover' or 'contain' (optional)
  - background_color: {String} The background color of the media (optional)

  Used:
  - sections/main-product.liquid: The main product section
  - template/product.quick-buy-modal.liquid: The product modal template
{% endcomment %}

{%- liquid
  assign first_item_class = ''
  if md_two_columns and first_item_full
    assign first_item_class = 'md-item-span-2'
  endif

  # Aspect ratio defaults to 'natural'
  unless aspect_ratio
    assign aspect_ratio = 'natural'
  endunless

  # If the section object is not found, the snippet is being used in the quick view
  if section
    assign section_id = section.id
  else
    assign section_id = 'quick-view'
  endif
-%}

<gridy-slider
  id="slider-{{ section_id }}"
  class="gridy-slider product-media-slider"
  data-mobile-enabled="{{ slider_mobile }}"
  data-tablet-enabled="{{ slider_mobile }}"
  data-desktop-enabled="{{ slider_desktop }}"
  data-arrows="true"
  {%- if product.selected_or_first_available_variant.featured_media.id -%}
  data-init-scroll-to="item-{{ product.selected_or_first_available_variant.featured_media.id }}"
  {%- endif -%}>

  <div
    class="gridy-track scrollbar--hide grid sm-gap grid-cols-1{% if md_two_columns %} md-grid-cols-2{% endif %}{% if slide_peek %} slide-peek{% endif %}"
    style="
      --gap: {{ media_gap | default: '0' }};
      --sm-gap: {{ sm_media_gap | default: '0' }};
      --sm-br: {{ sm_border_radius | default: '0' | append: 'px' }};">
      {%- for media in product.media -%}
        {%- liquid
          if forloop.index == 1
            assign custom_classes = first_item_class
          else
            assign custom_classes = ''
          endif

         assign lazyload = false
         if forloop.index > 2
           assign lazyload = true
         endif
        -%}
      <div id="item-{{ media.id }}" class="product-media sm-br {{ custom_classes }}">
        {% if media.media_type != 'model' and show_zoom_mobile or show_zoom_desktop %}
          <button type="button" data-open="modal--zoom-gallery-{{ section_id }}?scroll=modal-item-{{ media.id }}" class="product-media-zoom-link{% unless show_zoom_mobile %} sm-down-hide{% endunless %}{% unless show_zoom_desktop %} sm-hide{% endunless %}" aria-label="{{ 'accessibility.view_gallery_item' | t: item: forloop.index, total: product.media.size }}" aria-controls="modal--zoom-gallery-{{ section_id }}?scroll=modal-item-{{ media.id }}" aria-haspopup="dialog"></button>
        {% endif %}
        {%- render 'product-media',
          media: media,
          aspect_ratio: aspect_ratio,
          lazyload: lazyload,
          sizing_rule: sizing_rule,
          background_color: background_color,
          sizes: sizes,
          in_modal: false
        -%}
      </div>
    {%- endfor -%}
  </div>

  {% if product.media.size > 1 %}
    {% render 'gridy-arrows' %}
  {% endif %}
</gridy-slider>