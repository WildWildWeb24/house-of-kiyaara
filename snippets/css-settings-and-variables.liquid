{%- liquid
  assign body_font_bold = settings.base_font | font_modify: 'weight', 'bold'
  assign body_font_italic = settings.base_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

  # Letter spacing values are given between -20 and 100 where 0 is default
  # We use em-units for letter spacing to keep the distance consistent
  assign letter_spacing_multiplier = 0.01

  assign sale_price_text = settings.sale_price_text | default: 'transparent'
-%}

{% style %}
  {{ settings.base_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {{ settings.header_font | font_face: font_display: 'swap' }}

  /* Colors - Schemes */
  {% for scheme in settings.color_schemes -%}
    {%- assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id -%}
    {%- assign background_lightness = scheme.settings.background | color_extract: 'lightness' -%}
    {% if forloop.index == 1 -%}
    :root,
    {%- endif %}
    .color-{{ scheme.id }} {
      --color-foreground: {{ scheme.settings.foreground }};
      --color-background: {{ scheme.settings.background }};
      --color-background-gradient: {{ scheme.settings.background_gradient }};
      --color-button-foreground: {{ scheme.settings.button_foreground }};
      --color-button-background: {{ scheme.settings.button_background }};
      --color-outlines: {{ scheme.settings.outlines }};
      --color-borders: {{ scheme.settings.borders }};

      --color-card-foreground: {{ scheme.settings.card_foreground }};
      --color-card-background: {{ scheme.settings.card_background }};
      --color-card-borders: {{ scheme.settings.card_borders }};
      --color-card-button-foreground: {{ scheme.settings.card_button_foreground }};
      --color-card-button-background: {{ scheme.settings.card_button_background }};

      --color-overlay-text: {{ scheme.settings.overlay_text }};
      --color-overlay-buttons: {{ scheme.settings.overlay_buttons }};
      --color-overlay: {{ scheme.settings.overlay }};

      --color-foreground-rgb: {{ scheme.settings.foreground.red }} {{ scheme.settings.foreground.green }} {{ scheme.settings.foreground.blue }};
      --color-background-rgb: {{ scheme.settings.background.red }} {{ scheme.settings.background.green }} {{ scheme.settings.background.blue }};
      --color-button-foreground-rgb: {{ scheme.settings.button_foreground.red }} {{ scheme.settings.button_foreground.green }} {{ scheme.settings.button_foreground.blue }};
      --color-button-background-rgb: {{ scheme.settings.button_background.red }} {{ scheme.settings.button_background.green }} {{ scheme.settings.button_background.blue }};
      --color-overlay-rgb: {{ scheme.settings.overlay.red }} {{ scheme.settings.overlay.green }} {{ scheme.settings.overlay.blue }};

      {% if background_lightness > 60 -%}
        --color-background-alt: {{ scheme.settings.background | color_darken: 6 }};
      {% else -%}
        --color-background-alt: {{ scheme.settings.background | color_lighten: 6 }};
      {% endif -%}

      {% if sale_price_text != 'transparent' -%}
        {%- assign sale_contrast_background = sale_price_text | color_contrast: scheme.settings.background -%}
        {%- assign sale_contrast_foreground = sale_price_text | color_contrast: scheme.settings.foreground -%}

        {%- assign sale_contrast_card_background = sale_price_text | color_contrast: scheme.settings.card_background -%}
        {%- assign sale_contrast_card_foreground = sale_price_text | color_contrast: scheme.settings.card_foreground -%}

        {% if sale_contrast_foreground > sale_contrast_background -%}
          --sale-price-padding: 0.2em 0.4em;
          --color-sale-price-background: {{ scheme.settings.foreground }};
        {% else -%}
          --sale-price-padding: 0;
          --color-sale-price-background: {{ scheme.settings.background }};
        {% endif -%}

        {% if sale_contrast_card_foreground > sale_contrast_card_background -%}
          --sale-price-card-padding: 0.2em 0.4em;
          --color-sale-price-card-background: {{ scheme.settings.card_foreground }};
        {% else -%}
          --sale-price-card-padding: 0;
          --color-sale-price-card-background: {{ scheme.settings.card_background }};
        {% endif -%}
      {% endif %}
  }
  {% endfor %}

  {{ scheme_classes | prepend: 'body' }} {
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  :root {
    --ideal-width: {{ settings.content_ideal_width | append: 'px' }};
    --container-inner-width: min(100vw - var(--container-margin)*2  , var(--ideal-width));

     /* Colors - Status indicator */
    --success: #31862D;
    --success-foreground: #FFFFFF;
    --error: #DD4242;
    --error-foreground: #FFFFFF;

    /* Colors - Special colors */
    {%- assign cart_dot_contrast = settings.cart_dot | color_contrast: '#fff' -%}
    {% if cart_dot_contrast >= 4 -%}
      --cart-dot-foreground: #fff;
    {% else -%}
      --cart-dot-foreground: #000;
    {% endif -%}
    --cart-dot-background: {{ settings.cart_dot }};
    --placeholder-bg: rgba(233, 233, 233);
    --review-stars: {{ settings.review_stars }};


    /* Typography - Base/Body */
    --font-body-family: {{ settings.base_font.family }}, {{ settings.base_font.fallback_families }};
    --font-body-style: {{ settings.base_font.style }};
    --font-body-weight: {{ settings.base_font.weight }};
    --font-body-line-height: {{ settings.base_line_height }};
    --font-body-letter-spacing: {{ settings.base_letter_spacing | times: letter_spacing_multiplier | append: 'em' }};
    --font-body-text-transform: none;

    /* Typography - Heading/Titles */
    --font-heading-family: {{ settings.header_font.family }}, {{ settings.header_font.fallback_families }};
    --font-heading-style: {{ settings.header_font.style }};
    --font-heading-weight: {{ settings.header_font.weight }};
    --font-heading-line-height: {{ settings.header_line_height }};
    --font-heading-letter-spacing: {{ settings.header_letter_spacing | times: letter_spacing_multiplier | append: 'em' }};
    --font-heading-text-transform: {% if settings.header_uppercase %}uppercase{% else %}none{% endif %};

    /* Typography - Subheading/Subtitle */
    {% if settings.subheader_font == 'base' -%}
    --font-subheader-family: var(--font-body-family);
    --font-subheader-style: var(--font-body-style);
    --font-subheader-weight: var(--font-body-weight);
    {% else -%}
    --font-subheader-family: var(--font-heading-family);
    --font-subheader-style: var(--font-heading-style);
    --font-subheader-weight: var(--font-heading-weight);
    {% endif -%}
    --font-subheader-text-transform: {% if settings.subheader_uppercase %}uppercase{% else %}none{% endif %};
    --font-subheader-letter-spacing: {{ settings.subheader_letter_spacing | times: letter_spacing_multiplier | append: 'em' }};

    /* Typography - Buttons */
    {% if settings.button_font == 'base' -%}
    --font-button-family: var(--font-body-family);
    --font-button-style: var(--font-body-style);
    --font-button-weight: var(--font-body-weight);
    {% elsif settings.button_font == 'base-bold' -%}
    --font-button-family: var(--font-body-family);
    --font-button-style: var(--font-body-style);
    --font-button-weight: {{ body_font_bold.weight }};
    {% else -%}
    --font-button-family: var(--font-heading-family);
    --font-button-style: var(--font-heading-style);
    --font-button-weight: var(--font-heading-weight);
    {% endif -%}
    --font-button-text-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
    --font-button-size: {{ settings.button_font_scaling_property | append: 'px' }};
    --font-button-letter-spacing: {{ settings.button_letter_spacing | times: letter_spacing_multiplier | append: 'em'}};

    /* Typography - Site header */
    {% if settings.site_header_font == 'base' -%}
    --font-site-header-family: var(--font-body-family);
    --font-site-header-style: var(--font-body-style);
    --font-site-header-weight: var(--font-body-weight);
    {% elsif settings.site_header_font == 'base-bold' -%}
    --font-site-header-family: var(--font-body-family);
    --font-site-header-style: var(--font-body-style);
    --font-site-header-weight: {{ body_font_bold.weight }};
    {% else -%}
    --font-site-header-family: var(--font-heading-family);
    --font-site-header-style: var(--font-heading-style);
    --font-site-header-weight: var(--font-heading-weight);
    {% endif -%}
    --font-site-header-text-transform: {% if settings.site_header_uppercase %}uppercase{% else %}none{% endif %};
    --font-site-header-size: {{ settings.site_header_font_scaling_property | append: 'px' }};
    --font-site-header-letter-spacing: {{ settings.site_header_letter_spacing | times: letter_spacing_multiplier | append: 'em'}};

    /* Typography - Toolbar */
    {% if settings.toolbar_font == 'base' -%}
    --font-toolbar-family: var(--font-body-family);
    --font-toolbar-style: var(--font-body-style);
    --font-toolbar-weight: var(--font-body-weight);
    {% else -%}
    --font-toolbar-family: var(--font-heading-family);
    --font-toolbar-style: var(--font-heading-style);
    --font-toolbar-weight: var(--font-heading-weight);
    {% endif -%}
    --font-toolbar-text-transform: {% if settings.toolbar_uppercase %}uppercase{% else %}none{% endif %};
    --font-toolbar-size: {{ settings.toolbar_font_scaling_property | append: 'px' }};
    --font-toolbar-letter-spacing: {{ settings.toolbar_letter_spacing | times: letter_spacing_multiplier | append: 'em'}};

    /* Typography - Navigation */
    {% if settings.navigation_font == 'base' -%}
    --font-navigation-family: var(--font-body-family);
    --font-navigation-style: var(--font-body-style);
    --font-navigation-weight: var(--font-body-weight);
    {% else -%}
    --font-navigation-family: var(--font-heading-family);
    --font-navigation-style: var(--font-heading-style);
    --font-navigation-weight: var(--font-heading-weight);
    {% endif -%}
    --font-navigation-size: {{ settings.navigation_font_scaling_property | append: 'px' }};
    --font-navigation-letter-spacing: {{ settings.navigation_letter_spacing | times: letter_spacing_multiplier | append: 'em' }};
    --font-navigation-text-transform: {% if settings.navigation_uppercase %}uppercase{% else %}none{% endif %};

    /* Badges */
    {% if settings.badge_font == 'base' -%}
    --font-badge-family: var(--font-body-family);
    --font-badge-style: var(--font-body-style);
    --font-badge-weight: var(--font-body-weight);
    {% else -%}
    --font-badge-family: var(--font-heading-family);
    --font-badge-style: var(--font-heading-style);
    --font-badge-weight: var(--font-heading-weight);
    {% endif -%}
    --font-badge-text-transform: {% if settings.badge_uppercase %}uppercase{% else %}none{% endif %};

    --font-badge-size: {{ settings.badge_font_scaling_property | append: 'px' }};
    --font-badge-letter-spacing: {{ settings.badge_letter_spacing | times: letter_spacing_multiplier | append: 'em' }};
    --badge-border-radius: {{ settings.badge_border_radius | append: 'px' }};

    --badge-color-foreground--sale: {{ settings.badge_sale_foreground }};
    --badge-color-background--sale: {{ settings.badge_sale_background }};

    --badge-color-foreground--preorder: {{ settings.badge_preorder_foreground }};
    --badge-color-background--preorder: {{ settings.badge_preorder_background }};

    --badge-color-foreground--new: {{ settings.badge_new_foreground }};
    --badge-color-background--new: {{ settings.badge_new_background }};

    --badge-color-foreground--soldout: {{ settings.badge_sold_out_foreground }};
    --badge-color-background--soldout: {{ settings.badge_sold_out_background }};

    --badge-color-foreground--rating: {{ settings.badge_rating_foreground }};
    --badge-color-background--rating: {{ settings.badge_rating_background }};

    --badge-padding: {% if settings.badge_padding == 'none' %}0{% elsif settings.badge_padding == 'small' %}0.6rem 1.2rem{% elsif settings.badge_padding == 'medium' %}1rem 2rem{% endif %};

    {% if settings.custom_badges != empty -%}
    {%- assign custom_badges_array = settings.custom_badges | split: ';' -%}
    {%- for custom_badge in custom_badges_array -%}
    {%- assign custom_badge_array = custom_badge | split: ':' -%}
    {%- assign custom_badge_class = custom_badge_array[0] | handleize -%}
    --badge-color-foreground--custom-{{ custom_badge_class }}: {{ custom_badge_array[2] }};
    --badge-color-background--custom-{{ custom_badge_class }}: {{ custom_badge_array[1] }};
    {%- endfor %}
    {%- endif %}

    /* Drawers */
    --drawers-overlay-alpha: {{ settings.drawers_overlay_str | divided_by: 100.00 }};
    --drawers-overlay-blur: {{ settings.drawers_blur | append: 'px' }};

    /* Modals */
    --modals-overlay-alpha: {{ settings.modals_overlay_str | divided_by: 100.00 }};
    --modals-overlay-blur: {{ settings.modals_blur | append: 'px' }};

    /* Cards */
    --card-border-radius: {{ settings.card_border_radius | append: 'px' }};
    --card-body-padding: 12px;
    --card--product-title-transform: {% if settings.product_card_title_uppercase %}uppercase{% else %}none{% endif %};


    /* Aesthetics */
    --button-padding: {{ settings.button_padding }};
    --button-round-padding: 10px;
    --button-border-radius: {% if settings.button_shape == 'rounded' -%} 8px {% elsif settings.button_shape == 'pill' -%} 200px {% elsif settings.button_shape == 'lined' -%} 6px {%- else -%} 0px {%- endif %};

    --hotspot-dot-border-radius: {% if settings.hotspot_dot_shape == 'rounded' -%} 8px {% elsif settings.hotspot_dot_shape == 'circle' -%} 50% {%- else -%} 0px {%- endif %};

    --box-shadow-rgba: rgba(0,0,0,.20);
    --box-shadow--small: 0 1px 3px var(--box-shadow-rgba);
    --box-shadow--default: 0 3px 6px var(--box-shadow-rgba);
    --box-shadow--big: 0 6px 18px var(--box-shadow-rgba);
    --box-shadow-button: 0 3px 6px var(--box-shadow-rgba);

    --modal-border-radius: {{ settings.modal_border_radius | append: 'px' }};
    --icon-stroke: {{ settings.icon_stroke }};
    --icon-stroke-px: {{ settings.icon_stroke | append: 'px' }};

    {%- if settings.enable_br_on_images -%}
      --br-img: {{ settings.card_border_radius | append: 'px' }};
    {%- else -%}
      --br-img: 0;
    {%- endif -%}

    /* Forms and inputs */
    --input-background: #FFFFFF;
    --input-foreground: #111111;
    --input-border-width: 1px;
    --input-border-color: #DDDDDD;
    --input-border-radius: 6px;
    --input-box-shadow: inset 2px 2px 6px rgba(0,0,0,.1);
    --input-letter-spacing: 0;

    /* Other */
    {%- assign modal_scheme_id = settings.color_scheme_modals | strip -%}
    {%- assign modal_scheme = settings.color_schemes | where: 'id', modal_scheme_id | first -%}
    --css-icon-close: url("data:image/svg+xml,%3Csvg version='1.1' xmlns='http://www.w3.org/2000/svg' x='0px' y='0px' width='48px' height='48px' viewBox='0 0 48 48' %3E%3Cstyle%3E .line%7Bfill:none;stroke:%23{{ modal_scheme.settings.foreground | remove: '#' }};stroke-linecap:round;stroke-width:{{ settings.icon_stroke }};stroke-linejoin:round;%7D%0A%3C/style%3E%3Ccircle cx='24' cy='24' r='24' fill='%23{{ modal_scheme.settings.background | remove: '#' }}' /%3E%3Cline class='line' x1='30' y1='18' x2='18' y2='30'/%3E%3Cline class='line' x1='18' y1='18' x2='30' y2='30'/%3E%3C/svg%3E");
    --css-icon-full-screen: url("data:image/svg+xml,%3Csvg version='1.1' xmlns='http://www.w3.org/2000/svg' x='0px' y='0px' width='44px' height='44px' viewBox='0 0 44 44' %3E%3Cstyle%3E .line%7Bfill:none;stroke:%23{{ modal_scheme.settings.foreground | remove: '#' }};stroke-linecap:round;stroke-width:{{ settings.icon_stroke }};stroke-linejoin:round;%7D%0A%3C/style%3E%3Ccircle cx='22' cy='22' r='18' fill='%23{{ modal_scheme.settings.background | remove: '#' }}' /%3E%3Cpolyline class='line' points='15 20 15 15 20 15'/%3E %3Cpolyline class='line' points='24 15 29 15 29 20'/%3E %3Cpolyline class='line' points='29 24 29 29 24 29'/%3E %3Cpolyline class='line' points='20 29 15 29 15 24'/%3E %3Cline class='line' x1='15' y1='15' x2='19' y2='19'/%3E %3Cline class='line' x1='29' y1='15' x2='25' y2='19'/%3E %3Cline class='line' x1='29' y1='29' x2='25' y2='25'/%3E %3Cline class='line' x1='15' y1='29' x2='19' y2='25'/%3E%3C/svg%3E");
    --css-icon-zoom-in: url("data:image/svg+xml,%3Csvg version='1.1' xmlns='http://www.w3.org/2000/svg' x='0px' y='0px' width='44px' height='44px' viewBox='0 0 44 44' %3E%3Cstyle%3E .line%7Bfill:none;stroke:%23{{ modal_scheme.settings.foreground | remove: '#' }};stroke-linecap:round;stroke-width:{{ settings.icon_stroke }};stroke-linejoin:round;%7D%0A%3C/style%3E%3Ccircle cx='22' cy='22' r='18' fill='%23{{ modal_scheme.settings.background | remove: '#' }}' /%3E%3Ccircle class='line' cx='21' cy='21' r='6'/%3E%3Cline class='line' x1='21' y1='19' x2='21' y2='23'/%3E%3Cline class='line' x1='19' y1='21' x2='23' y2='21'/%3E%3Cline class='line' x1='29.6' y1='29.6' x2='25.2' y2='25.2'/%3E%3C/svg%3E");
    --header-height: auto;
    --toolbar-height: auto;

    --noise-pattern: url({{ 'noise-pattern-bw.png' | asset_img_url }});
    --noise-pattern-size: {{ settings.grain_size }};
    --noise-pattern-opacity: {{ settings.grain_opacity | divided_by: 100.00 | default: 0.25  }};
    --vignette-opacity: {{ settings.vignette_opacity | divided_by: 100.00 | default: 0.25  }};
  }

  html {
    {%- comment -%}
      Default font size in browsers is usually 16px. By setting font size to be 62.5% we are setting base size as 10px.
      This means that 1rem will equal 10px, 1.6rem equals 16px etc.

      Since some users might have set different font size in their browser settings due to accessibility reasons we use percentages
      instead of pixel size. This way users preferences are respected.
    {%- endcomment -%}
    {%- assign font_scale_property = settings.font_scaling_property | divided_by: 16.00 -%}
    font-size: {{ 62.5 | times: font_scale_property | append: '%' }};

    --gutter: 24px;
    --grid-gap: {{ settings.grid_gap | append: 'px' }};
    --section-margin: 0;
    --section-padding: {{ settings.section_padding | split: ',' | first }};
    --container-margin: {{ settings.container_margin | append: 'px' }};
    {%- assign total_gutters = settings.gutter_sm | times: 11 -%}
    --max-col-width: {{ settings.content_ideal_width | minus: total_gutters | divided_by: 12 | append: 'px' }}
  }

  @media only screen and (min-width: 768px) {
    :root {
      /* Cards */
      --card-body-padding: 20px;
    }
    html {
      {%- assign font_desktop_scale_property = settings.font_scaling_desktop_property | divided_by: 18.00 -%}
      font-size: {{ 62.5 | times: font_desktop_scale_property | append: '%' }};
      --gutter: 32px;
      --grid-gap: {{ settings.grid_gap_sm | append: 'px' }};
      --section-margin: 0;
      --section-padding: {{ settings.section_padding | split: ',' | last }};
      --container-margin: {{ settings.container_margin_sm | append: 'px' }};
    }
  }

  /* ---------- */
  /* TYPOGRAPHY */
  body, *.font-body { --font-size: 1.6rem }
  h1,.h1   { --font-size: 3.2rem }
  h2,.h2   { --font-size: 2.6rem }
  h3,.h3   { --font-size: 2.2rem }
  h4,.h4   { --font-size: 2.0rem }
  h5,.h5   { --font-size: 1.8rem }
  h6,.h6   { --font-size: 1.6rem }
  .caption { --font-size: 1.2rem }

  body, .font-body {
    font-size: var(--font-size);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: var(--font-body-line-height);
    letter-spacing: var(--font-body-letter-spacing);
    text-transform: var(--font-body-text-transform);
  }

  h1,h2,h3,h4,h5,h6,
  .h1,.h2,.h3,.h4,.h5,.h6 {
    font-size: var(--font-size);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: var(--font-heading-line-height);
    letter-spacing: var(--font-heading-letter-spacing);
    text-transform: var(--font-heading-text-transform);
    word-break: break-word;
  }

  @media only screen and (min-width: 768px) {
    body, *.font-body { --font-size: 1.8rem }
    h1,.h1   { --font-size: 4.0rem }
    h2,.h2   { --font-size: 3.2rem }
    h3,.h3   { --font-size: 2.6rem }
    h4,.h4   { --font-size: 2.2rem }
    h5,.h5   { --font-size: 2.0rem }
    h6,.h6   { --font-size: 1.8rem }
    .caption { --font-size: 1.4rem }
  }

  /* Size modifiers */
  .size--nano, .rte.size--nano *              { font-size: calc(var(--font-size)*0.65) }
  .size--tiny, .rte.size--tiny *              { font-size: calc(var(--font-size)*0.75) }
  .size--small, .rte.size--small *            { font-size: calc(var(--font-size)*0.85) }
  .size--default, .rte.size--default *        { font-size: var(--font-size) }
  .size--large, .rte.size--large *            { font-size: calc(var(--font-size)*1.25) }
  .size--huge, .rte.size--huge *              { font-size: calc(var(--font-size)*1.50) }
  .size--gigantic, .rte.size--gigantic *      { font-size: calc(var(--font-size)*2.00) }
  .size--outrageous, .rte.size--outrageous *  { font-size: calc(var(--font-size)*3.00) }

  .btn.size--nano, .text-button.size--nano       { font-size: calc(var(--font-button-size)*0.65) !important }
  .btn.size--tiny, .text-button.size--tiny       { font-size: calc(var(--font-button-size)*0.75) !important }
  .btn.size--small, .text-button.size--small      { font-size: calc(var(--font-button-size)*0.85) !important }
  .btn.size--default, .text-button.size--default    { font-size: var(--font-button-size) !important }
  .btn.size--large, .text-button.size--large      { font-size: calc(var(--font-button-size)*1.25) !important }
  .btn.size--huge, .text-button.size--huge       { font-size: calc(var(--font-button-size)*1.50) !important }
  .btn.size--gigantic, .text-button.size--gigantic   { font-size: calc(var(--font-button-size)*2.00) !important }
  .btn.size--outrageous, .text-button.size--outrageous { font-size: calc(var(--font-button-size)*3.00) !important }

  @media only screen and (min-width: 768px) {
    .sm-size--nano, .rte.sm-size--nano *              { font-size: calc(var(--font-size)*0.65) }
    .sm-size--tiny, .rte.sm-size--tiny *              { font-size: calc(var(--font-size)*0.75) }
    .sm-size--small, .rte.sm-size--small *            { font-size: calc(var(--font-size)*0.85) }
    .sm-size--default, .rte.sm-size--default *        { font-size: var(--font-size) }
    .sm-size--large, .rte.sm-size--large *            { font-size: calc(var(--font-size)*1.25) }
    .sm-size--huge, .rte.sm-size--huge *              { font-size: calc(var(--font-size)*1.50) }
    .sm-size--gigantic, .rte.sm-size--gigantic *      { font-size: calc(var(--font-size)*2.00) }
    .sm-size--outrageous, .rte.sm-size--outrageous *  { font-size: calc(var(--font-size)*3.00) }

    .btn.sm-size--nano, .text-button.sm-size--nano       { font-size: calc(var(--font-button-size)*0.65) !important }
    .btn.sm-size--tiny, .text-button.sm-size--tiny       { font-size: calc(var(--font-button-size)*0.75) !important }
    .btn.sm-size--small, .text-button.sm-size--small      { font-size: calc(var(--font-button-size)*0.85) !important }
    .btn.sm-size--default, .text-button.sm-size--default    { font-size: var(--font-button-size) !important }
    .btn.sm-size--large, .text-button.sm-size--large      { font-size: calc(var(--font-button-size)*1.25) !important }
    .btn.sm-size--huge, .text-button.sm-size--huge       { font-size: calc(var(--font-button-size)*1.50) !important }
    .btn.sm-size--gigantic, .text-button.sm-size--gigantic   { font-size: calc(var(--font-button-size)*2.00) !important }
    .btn.sm-size--outrageous, .text-button.sm-size--outrageous { font-size: calc(var(--font-button-size)*3.00) !important }
  }

  /* Style modifiers */
  .style--subdued   { opacity: 0.65 }
  .style--subdued-light   { opacity: 0.35 }
  .style--bold      { font-weight: bold !important}
  .style--uppercase { text-transform: uppercase !important}

  .subheading {
    font-family: var(--font-subheader-family);
    font-weight: var(--font-subheader-weight);
    font-style: var(--font-subheader-style);
    letter-spacing: var(--font-subheader-letter-spacing);
    text-transform: var(--font-subheader-text-transform);
    --font-size: 1.8rem;
  }

  /* Badge style classes */
  .badge.sale, .style--badge-sale {
    color: var(--badge-color-foreground--sale);
    background-color: var(--badge-color-background--sale);
  }
  .badge.preorder, .style--badge-preorder {
    color: var(--badge-color-foreground--preorder);
    background: var(--badge-color-background--preorder);
  }
  .badge.new, .style--badge-new {
    color: var(--badge-color-foreground--new);
    background: var(--badge-color-background--new);
  }
  .badge.soldout, .style--badge-soldout {
    color: var(--badge-color-foreground--soldout);
    background: var(--badge-color-background--soldout);
  }
  .badge.rating, .style--badge-rating {
    color: var(--badge-color-foreground--rating);
    background: var(--badge-color-background--rating);
  }

  {% if settings.custom_badges != empty -%}
    {%- assign custom_badges_array = settings.custom_badges | strip_newlines | split: ';' -%}
    {%- for custom_badge in custom_badges_array -%}
    {%- assign custom_badge_class = custom_badge | split: ':' | first | handleize -%}
    .badge.custom-{{ custom_badge_class }}, .style--badge-custom-{{ custom_badge_class }} {
      color: var(--badge-color-foreground--custom-{{ custom_badge_class }});
      background: var(--badge-color-background--custom-{{ custom_badge_class }});
    }
    {%- endfor %}
  {%- endif %}

  {% if settings.product_card_custom_aspect_ratio != blank -%}
    .card--product .card-media picture {
      aspect-ratio: {{ settings.product_card_custom_aspect_ratio }};
    }
  {%- endif %}

  {% if sale_price_text != 'transparent' -%}
    .price-item--sale {
      color: {{ settings.sale_price_text }};
      background-color: var(--color-sale-price-background);
      padding: var(--sale-price-padding);
    }
    .card:not(.card--traditional,.cart-recommendation-item,.upsell-card) .price-item--sale {
      background-color: var(--color-sale-price-card-background);
    }
  {%- endif %}
{% endstyle %}