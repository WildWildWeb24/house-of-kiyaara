{%- liquid
  # Snippet for Cart Footer used in both drawer and cart template
  # Note: #cart-footer.inner_html is replaced in AJAX calls
-%}

<div id="cart-footer" class="cart-footer">
  {%- liquid
    # Checkout guard data for assets/cart-checkout-guard.js (re-rendered with #cart-footer on every cart change)
    assign guard_paid_lines = 0
    for item in cart.items
      if item.final_line_price > 0
        assign guard_paid_lines = guard_paid_lines | plus: 1
      endif
    endfor
  -%}
  <span hidden data-checkout-guard data-item-count="{{ cart.item_count }}" data-total="{{ cart.total_price }}" data-paid-lines="{{ guard_paid_lines }}"></span>
  {% if cart.item_count > 0 %}
    <div id="cart-subtotal" class="cart__subtotals">
      <div class="cart__subtotal">
        <span>{{ 'sections.cart.subtotal' | t }}</span>
        <span>{{ cart.original_total_price | money_with_currency }}</span>
      </div>
    </div>

    <div class="cart__extras">
      {%- render 'cart-discounts', cart: cart -%}
    </div>

    <div class="cart-buttons {%- if settings.show_cart_link %} cart-buttons--grid{% endif %}">
      <button class="btn btn--full btn--primary size--small sm-size--default" type="submit" name="checkout" form="cart">
        {{ 'sections.cart.checkout' | t }}
      </button>
      <p class="cart-checkout-guard__msg size--tiny" role="alert" hidden data-checkout-guard-msg data-msg-free="{{ 'sections.cart.checkout_blocked_free' | t | escape }}" data-msg-busy="{{ 'sections.cart.checkout_blocked_busy' | t | escape }}"></p>

      {%- if settings.show_cart_link -%}
        <a href="{{ routes.cart_url }}" class="btn btn--secondary size--small sm-size--default btn--full view-cart">
          {{- 'general.cart.view_cart_link' | t -}}
        </a>
      {%- endif -%}

      {%- if additional_checkout_buttons and settings.show_accelerated_checkout -%}
        <div class="additional-checkout-buttons" style="--spacing: 4px;">
          {{ content_for_additional_checkout_buttons }}
        </div>
      {%- endif -%}
    </div>

    <div class="cart-secure-payment">
      <p class="cart-secure-payment__text size--tiny text-align-left">Secure and easy payment process</p>
      <img src="https://cdn.shopify.com/s/files/1/0567/8661/6449/files/HOK_Secure_Payments.png?v=1787296891" alt="Secure and easy payment process" class="cart-secure-payment__image" width="905" height="100" loading="lazy">  
    </div>

    {%- capture cart_footer_text %}
      {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
        {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
      {%- elsif cart.taxes_included -%}
        {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
      {%- elsif shop.shipping_policy.body != blank -%}
        {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
      {%- else -%}
        {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
      {%- endif -%}
    {%- endcapture -%}

    {%- if cart_footer_text != blank -%}
      <p class="cart__tax size--tiny style--subdued text-align-center">
        {{ cart_footer_text }}
      </p>
    {%- endif -%}
  {% endif %}
</div>

<style>
  .cart-secure-payment {
    margin-top: 6px;
  }

  .cart-secure-payment__text {
    margin-bottom: 4px;
  }

  .cart-secure-payment__image {
    display: block;
    width: 100%;
    max-width: 500px;
    height: auto;
    margin: 0 auto;
  }
</style>

