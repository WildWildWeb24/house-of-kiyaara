{% comment %} Modal container {% endcomment %}
<div id="modal-password" class="modal color-{{ settings.color_scheme_modals }}" style="--dialog-height:auto;" data-modal data-parent>
  {% comment %} Modal {% endcomment %}
  <div id="dialog" class="modal-dialog" data-modal-dialog role="dialog" aria-modal="true" aria-labelledby="password-modal-title" tabindex="-1">
    {% render 'close-button', button_class: 'modal-close', context: 'password-modal' %}

    <div class="modal-body text-align-center p-40 sm-p-64" data-modal-body>
      <h3 class="h5 subheading" id="password-modal-title">{{ 'general.password_page.login_form_heading' | t }}</h3>

      <p>{{ 'general.password_page.admin_link_html' | t }}</p>

      {%- form 'storefront_password', class: 'form mt-40' -%}
        <div class="field">
          <input class="field__input"
            type="password"
            name="password"
            id="password"
            autocomplete="current-password"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordLoginForm-password-error"
            {%- endif -%}
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" />
          <label class="field__label" for="password">
            {{ 'general.password_page.login_form_password_label' | t }}
          </label>

        </div>

        {%- if form.errors -%}
          <div id="PasswordLoginForm-password-error" role="status">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            <span class="password-form__message">{% render 'icon-error' %} {{ 'general.password_page.login_form_error' | t }}</span>
          </div>
        {%- endif -%}

        <button name="commit" class="btn btn--full mt-12">
          {{ 'general.password_page.login_password_button' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>

  {% comment %} Background, click to close {% endcomment %}
  <button type="button" class="page-overlay" aria-hidden="true" tabindex="-1" data-overlay></button>
</div>

<style>
  .password-form__message {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--error);
    margin: var(--gutter) 0;
  }
</style>