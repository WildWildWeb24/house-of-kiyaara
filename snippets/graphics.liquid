{% comment %}
  Graphics snippet that generates SVG graphics.

  Accepts:
  - graphics: {String} The type of graphic to render (required)
  - second_layer: {Boolean} Whether to use second layer of the graphic (optional)
  - height: {Number} The height of the graphic (optional)
  - sm_height: {Number} The height of the graphic for medium screens and up (optional)
  - class: {String} Additional classes for the graphic element (optional)
  - flip_horizontal: {Boolean} Whether to flip the graphic horizontally (optional)
  - fill: {String} The fill color of the graphic (optional)

  Used in:
  - sections/main-product.liquid: The main product section
{% endcomment %}

{% liquid
  assign height = height | default: 'auto'
  assign sm_height = sm_height | default: 'auto'

  if graphics == 'default' or graphics == blank
    assign graphics = settings.default_background_graphics
  endif
%}

{%- case graphics -%}
  {%- when 'tilted' -%}
    <svg class="graphics" aria-hidden="true" style="--height: {{ height }}; --sm-height: {{ sm_height }};" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 360" preserveAspectRatio="none">
      <polygon class="layer-main" points="0 279 0 359 0 360 1600 360 1600 359 0 279" fill="{{ fill }}"/>
      {% if second_layer -%}
        <path class="layer-secondary" d="M1600,0L200,360h1400V0Z" fill="{{ fill }}" style="opacity:0.15;"/>
      {%- endif %}
    </svg>
  {%- when 'convex' -%}
    <svg class="graphics" aria-hidden="true" style="--height: {{ height }}; --sm-height: {{ sm_height }};" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 160" preserveAspectRatio="none">
      <path class="layer-main" d="M0,160h1600v-20.35c-145.16-35.34-448.85-59.65-800-59.65S145.16,104.32,0,139.65v20.35Z" fill="{{ fill }}"/>
      {% if second_layer -%}
        <path class="layer-secondary" d="M0,160h1600v-40.69C1454.84,48.64,1151.15,0,800,0S145.16,48.64,0,119.31v40.69Z" fill="{{ fill }}" style="opacity:0.15;"/>
      {%- endif %}
    </svg>
  {%- when 'concave' -%}
    <svg class="graphics" aria-hidden="true" style="--height: {{ height }}; --sm-height: {{ sm_height }};" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 160" preserveAspectRatio="none">
      <path class="layer-main" d="M1600,160v-80c-145.16,35.49-448.85,59.91-800,59.91S145.16,115.49,0,80v80h1600Z" fill="{{ fill }}"/>
      {% if second_layer -%}
        <path class="layer-secondary" d="M1600,160V0c-145.16,73.93-448.85,130-800,130S145.16,73.93,0,0v160h1600Z" fill="{{ fill }}" style="opacity:0.15;"/>
      {%- endif %}
    </svg>
  {%- when 'curve' -%}
    <svg class="graphics" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" preserveAspectRatio="none">
      {% if second_layer -%}
        <path class="layer-secondary" fill="{{ fill }}" style="opacity:0.15;" d="M720 90C413.26 90 145.16 79.76 0 65v21c145.16 14.76 413.26 25 720 25s574.84-10.24 720-25V65c-145.16 14.76-413.26 25-720 25"/>
      {%- endif %}
      <path class="layer-main" fill="{{ fill }}" d="M0 85v35h1440V85c-145.16 14.9-413.26 25-720 25S145.16 99.9 0 85"/>
    </svg>
  {%- when 'jagged' -%}
    <svg class="graphics" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path class="layer-main" fill="{{ fill }}" d="M0 81.5 70 50l70 20 50-10 30 30 80-10 20 20 30-30 70 10 80-40 80 50 110-40 130 40 30-20 30 30 40-50 170 40 120-60 140 40 30-20 60 28.9V120H0z"/>
