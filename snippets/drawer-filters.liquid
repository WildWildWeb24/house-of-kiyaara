{%- liquid
  if context == 'search'
    assign results_count = 'templates.search.results_with_count' | t: count: search.results_count
  else
    assign results_count = 'products.facets.product_count_simple' | t: count: collection.products_count
  endif
%}

<div id="drawer-filter" class="drawer color-{{ settings.color_scheme_drawers }}" data-drawer data-parent style="opacity: 0; display: none;">
  {% if settings.drawer_appearance == 'modal' %}
    {% render 'close-button', button_class: 'drawer-close drawer-float-close', context: 'filters-drawer' %}
  {% endif %}

  <div class="drawer-panel user-select-none slide-from-left">

    <header class="drawer-header">
      <h2 class="drawer-title h1">{{ 'products.facets.filter_button' | t }}</h2>
      {% if settings.drawer_appearance == 'drawer' %}
        {%- render 'close-button', button_class: 'drawer-close' -%}
      {% endif %}
    </header>

    <div class="drawer-content scrollbar--hide --with-padding" style="padding-top: 0;">
      {% if show_sort %}
      <details class="filter-group" open>
        <summary style="border: 0;">
          <span>{{ 'products.facets.sort_button' | t }}</span>
          {% render 'icon-sort--small' %}
        </summary>
        <div class="content pt-12 pb-24">
          {% render 'sort-by', display_type: 'radio', name_suffix: '-drawer' %}
        </div>
      </details>
      {% endif %}
      <facets-form>
        <form>
          {%- render 'facets', context: context, show_swatches: show_swatches -%}
        </form>
      </facets-form>
    </div>

    <footer class="drawer-footer button-group">
      <p class="size--tiny style--subdued text-center mb-16 hide" id="facets-no-results-message">{{ 'products.facets.filters_zero_results' | t }}</p>
      <a href="#" class="btn btn--full with-button-count mb-12" data-drawer-close data-close>{{ 'products.facets.apply' | t }} <span class="button-count font-body size--nano" id="apply-count">{{ results_count }}</span></a>
      {%- if context == 'search' -%}
        <a href="{{ request.path }}?q={{ search.terms | escape }}&sort_by={{ search.sort_by }}" class="btn btn--secondary btn--full">{{ 'products.facets.clear_all' | t }}</a>
      {%- else -%}
        <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="btn btn--secondary btn--full">{{ 'products.facets.clear_all' | t }}</a>
      {%- endif -%}
    </footer>
  </div>

  {% comment %} Background, click to close {% endcomment %}
  <button type="button" class="page-overlay" data-overlay aria-hidden="true" tabindex="-1"></button>
</div>