{%- comment -%}
  Free scarf color chooser, shown under the free scarf line item in the cart.
  Params: item (cart line item)
  Click handling lives in assets/free-product.js (data-gift-swatch buttons).
{%- endcomment -%}
{%- liquid
  assign is_scarf_line = false
  if settings.enable_free_scarf and item.properties._free_product == 'true'
    for i in (1..3)
      assign scarf_key = 'free_scarf_product_' | append: i
      if settings[scarf_key].id == item.product_id
        assign is_scarf_line = true
      endif
    endfor
  endif
-%}
{%- if is_scarf_line -%}
  <div
    class="gift-scarf-chooser"
    style="--gs-size: {{ settings.free_scarf_swatch_size }}px; --gs-gap: {{ settings.free_scarf_swatch_gap }}px; --gs-ring: {{ settings.free_scarf_swatch_ring }}; --gs-margin-top: {{ settings.free_scarf_chooser_margin_top }}px;"
  >
    {%- if settings.free_scarf_chooser_heading != blank -%}
      <p class="gift-scarf-chooser__heading size--small style--subdued" id="gift-scarf-heading-{{ item.key | handleize }}">{{ settings.free_scarf_chooser_heading | escape }}</p>
    {%- endif -%}
    <div class="gift-scarf-chooser__swatches" role="group"{% if settings.free_scarf_chooser_heading != blank %} aria-labelledby="gift-scarf-heading-{{ item.key | handleize }}"{% endif %}>
      {%- for i in (1..3) -%}
        {%- assign product_key = 'free_scarf_product_' | append: i -%}
        {%- assign color_key = 'free_scarf_color_' | append: i -%}
        {%- assign label_key = 'free_scarf_label_' | append: i -%}
        {%- assign scarf = settings[product_key] -%}
        {%- if scarf != blank and scarf.price == 0 -%}
          {%- assign scarf_label = settings[label_key] | default: scarf.title -%}
          <button
            type="button"
            class="gift-scarf-swatch"
            data-gift-swatch
            data-variant-id="{{ scarf.selected_or_first_available_variant.id }}"
            aria-pressed="{% if scarf.id == item.product_id %}true{% else %}false{% endif %}"
            aria-label="{{ scarf_label | escape }}"
            title="{{ scarf_label | escape }}"
            style="--swatch-color: {{ settings[color_key] | default: '#cccccc' }};"
          ></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
