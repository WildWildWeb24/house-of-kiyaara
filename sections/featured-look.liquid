      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "t:sections.colors.overlay_opacity",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%"
      },
      {
        "type": "header",
        "content": "t:sections.headers.desktop_layout"
      },
      {
        "type": "select",
        "id": "media_position",
