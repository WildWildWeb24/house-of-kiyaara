{{ 'component-hotspots.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign section_header = section.blocks | where: 'type', 'section_header' | first
-%}

<div id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div class="grid col-align-items-center col-justify-items-center">
    <div class="col-12 col-sm-6 {% if section.settings.media_position == 'media_last' %} col-sm-order-2{% endif %}">
      <div class="hotspot-container sm-br-img" style="--overlay-opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};">
        {%- render 'picture',
          image_default: section.settings.image,
          sizes: '(max-width: 767px) 100vw, 50vw',
          preload: false,
          placeholder: 'collection-1'
        -%}

        {%- for block in product_blocks -%}
          <a href="{{ block.settings.product.url }}" class="hotspot hotspot--number animated color--{{ section.settings.color_hotspot }}" {{ block.shopify_attributes }}
            style="
              --hotspot-vertical-position: {{ block.settings.vertical_position }}%;
              --hotspot-horizontal-position: {{ block.settings.horizontal_position }}%;
            " aria-label="{{ block.settings.product.title }}">
            <span class="hotspot-dot">{{forloop.index}}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>

    <div class="col-12 col-sm-6">
        {% if section_header != blank %}
          {%- render 'section-header',
            size_multiplier: section_header.settings.size_multiplier,
            sm_size_multiplier: section_header.settings.sm_size_multiplier,
            text_align: section_header.settings.text_alignment,
            subtitle: section_header.settings.subtitle,
            subtitle_tag: section_header.settings.subtitle_tag,
            title: section_header.settings.title,
            title_tag: section_header.settings.title_tag,
            text: section_header.settings.text -%}
        {% endif %}
        <div class="featured-look-products standard-items-spacing">
          {% for block in product_blocks -%}
          {%- assign product_index = forloop.index -%}
          {%- render 'card-product',
            product: block.settings.product,
            card_layout_class: 'layout--thumbnail',
            quick_buy: false,
            number: product_index -%}
          {%- endfor %}
        </div>
    </div>
  </div>
</div>

{% schema %}
