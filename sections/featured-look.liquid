          },
          {
            "type": "text",
            "id": "title",
            "label": "t:inputs.text.title",
            "default": "t:blocks.section_header.name"
          },
          {
            "type": "richtext",
            "id": "text",
            "label": "t:inputs.text.text"
          },
          {
            "type": "text_alignment",
            "id": "text_alignment",
            "label": "t:sections.typography.text_align",
            "default": "left"
          },
          {
            "type": "header",
            "content": "t:blocks.section_header.heading_tags.header",
            "info": "t:blocks.section_header.heading_tags.info"
          },
          {
            "type": "select",
            "id": "subtitle_tag",
            "label": "t:blocks.section_header.subtitle_tag",
            "default": "h3",
            "options": [
              {
                "value": "h1",
                "label": "t:sections.typography.heading_tag.h1"
              },
              {
                "value": "h2",
                "label": "t:sections.typography.heading_tag.h2"
              },
              {
                "value": "h3",
                "label": "t:sections.typography.heading_tag.h3"
              },
              {
                "value": "h4",
                "label": "t:sections.typography.heading_tag.h4"
              },
              {
                "value": "h5",
                "label": "t:sections.typography.heading_tag.h5"
              },
              {
