{%- liquid
  # Controls visibility
  assign show_filters = section.settings.enable_filtering
  assign show_count = section.settings.show_count
  assign show_sort_by = section.settings.enable_sorting
  assign show_sidebar = section.settings.show_sidebar
  assign show_swatches = section.settings.enable_swatches

  # Items per row
  assign ipr_desktop = section.settings.md_items_per_row
  assign ipr_tablet = section.settings.sm_items_per_row
  assign ipr_mobile = section.settings.items_per_row
  assign ipr_array = ipr_mobile | append: ',' | append: ipr_tablet | append: ',' | append: ipr_desktop | split: ','

  # Action item variables
  assign actions_items_count = 0

  if show_filters
    assign actions_items_count = 1
  endif
  if show_count
    assign actions_items_count = actions_items_count | plus: 1
  endif
  if show_sort_by
    assign actions_items_count = actions_items_count | plus: 1
  endif

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
-%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div id="collection-ajax" data-ajax-parent class="container section-spacing custom-child-for-animation color-{{ section.settings.color_scheme }}"
    {% if custom_spacing -%}
    style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
    {%- endif %}>

    <div class="grid {% if show_sidebar %}grid--products-and-sidebar{% endif %}">
      <div class="col-12 {% if show_sidebar %}col-sidebar{% endif %}">
      {% if actions_items_count > 0 and show_sidebar %}
        {%- if show_filters -%}
          {%- assign filter_button_label = 'products.facets.filter_button' | t -%}
          {%- if show_sort_by -%}
            {%- assign filter_button_label = 'products.facets.filter_and_sort' | t -%}
          {%- endif -%}
          <button class="btn btn--full btn--secondary md-hide size--small" aria-controls="drawer-filter" data-open="drawer-filter">
            {{- filter_button_label -}}
          </button>
        {%- endif -%}
        <div class="product-grid-sidebar md-down-hide">
          {%- if section.settings.show_count -%}
            <div class="sidebar-group --count">
              <p class="products-count size--small mb-24 {% if show_filters and show_sort_by == false %}--to-right{% endif %} " id="products-count-ajax">
              {%- if collection.products_count == collection.all_products_count -%}
                {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
              {%- else -%}
                {{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
              {%- endif -%}
              </p>
            </div>
          {%- endif -%}
          {% if show_sort_by -%}
          <div class="sidebar-group --sorting">
            <details class="filter-group" open>
              <summary >
                <span>{{ 'products.facets.sort_button' | t }}</span>
                {% render 'icon-sort--small' %}
              </summary>
              <div class="content pt-12 pb-24">
                {% render 'sort-by' display_type: 'radio' %}
              </div>
            </details>
          </div>
          {% endif -%}
          <div class="sidebar-group --facets">
            {%- if show_filters -%}
            <facets-form>
              <form class="sidebar-facets">
                {%- render 'facets', context: 'collection', show_swatches: show_swatches, sidebar_facets: true -%}
              </form>
            </facets-form>
            {%- endif -%}
          </div>
        </div>
      {%- elsif actions_items_count > 0 -%}
        <div class="product-grid-actions items-count-{{ actions_items_count }}">
          {%- if section.settings.show_count -%}
            <p class="products-count size--tiny {% if show_filters and show_sort_by == false %}--to-right{% endif %} " id="products-count-ajax">
            {%- if collection.products_count == collection.all_products_count -%}
              {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
            {%- else -%}
              {{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
            {%- endif -%}
            </p>
          {%- endif -%}
          {%- if show_filters -%}
            <button class="btn btn--link size--small btn--with-icon filters-button" aria-controls="drawer-filter" data-open="drawer-filter">
              {{- 'products.facets.filter_button' | t }} <span class="link-icon">{%- render 'icon-filter--small' -%}</span>
            </button>
          {%- endif -%}
          {%- if show_sort_by -%}
            {% render 'sort-by' %}
          {%- endif -%}
        </div>
        {%- if show_filters -%}
          {%- render 'current-facets' -%}
        {%- endif -%}
      {% endif %}
      </div>

      <div class="col-12 {% if show_sidebar %}col-products{% endif %}">
        <div
          id="product-grid-ajax"
          data-id="{{ section.id }}"
          data-filtered-count="{{ collection.products_count }}"
          data-context="collection"
          class="grid grid-gap grid-cols-{{ ipr_mobile }} sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}">
          {%- if collection.products.size > 0 -%}
            {%- render 'collection-items', paginate: paginate, ipr_array: ipr_array, show_sidebar: show_sidebar -%}
          {%- else -%}
            <div class="text-align-center" style="grid-column-start: 1; grid-column-end: -1;">
              <h2>{{ 'sections.collection_template.empty' | t }}</h2>
              {% if show_filters %}
                <p>{{ 'sections.collection_template.use_fewer_filters_html' | t: class: 'link', link: collection.url }}</p>
              {% endif %}
            </div>
          {%- endif -%}
        </div>

        <div id="pagination-ajax">
          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '', pagination_type: section.settings.pagination_type %}
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>
{%- endpaginate -%}


{% if show_filters %}
  {%- assign show_sort_in_drawer = false -%}
  {%- if show_sidebar and show_sort_by -%}
    {%- assign show_sort_in_drawer = true -%}
  {%- endif -%}
  {%- render 'drawer-filters', show_swatches: show_swatches, show_sort: show_sort_in_drawer -%}
  <script type="text/javascript" src="{{ 'component-price-range.js' | asset_url }}" defer></script>
{% endif %}
{% if show_sort_by or show_filters %}
  <script type="text/javascript" src="{{ 'component-facets.js' | asset_url }}" defer></script>
{% endif %}

{% if section.settings.pagination_type == 'button' or section.settings.pagination_type == 'infinite' %}
  <script type="text/javascript" src="{{ 'infinite-scroll.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
  {
    "name": "t:sections.main-collection-product-grid.name",
    "class": "section--main-collection-product-grid anim-custom-child",
    "tag": "section",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.main-collection-product-grid.info"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "default",
        "label": "t:sections.colors.color_scheme.label"
      },
      {
        "type": "range",
        "id": "products_per_page",
        "min": 1,
        "max": 50,
        "default": 16,
        "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
      },
      {
        "type": "checkbox",
        "id": "show_count",
        "default": true,
        "label": "t:sections.main-collection-product-grid.settings.show_count.label"
      },
      {
        "type": "checkbox",
        "id": "enable_sorting",
        "default": true,
        "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
      },
      {
        "type": "checkbox",
        "id": "enable_filtering",
        "default": true,
        "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label"
      },
      {
        "type": "checkbox",
        "id": "enable_swatches",
        "label": "t:sections.main-collection-product-grid.settings.enable_swatches.label",
        "info": "t:sections.main-collection-product-grid.settings.enable_swatches.info",
        "default": true
      },
      {
        "type": "select",
        "id": "pagination_type",
        "label": "t:sections.main-collection-product-grid.settings.pagination.label",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "t:sections.main-collection-product-grid.settings.pagination.options.default"
          },
          {
            "value": "button",
            "label": "t:sections.main-collection-product-grid.settings.pagination.options.load_more"
          },
          {
            "value": "infinite",
            "label": "t:sections.main-collection-product-grid.settings.pagination.options.infinite"
          }
        ]
      },
      {
        "type": "header",
        "content": "t:sections.headers.desktop_layout"
      },
      {
        "type": "checkbox",
        "id": "show_sidebar",
        "label": "Show sidebar",
        "default": true
      },
      {
        "type": "range",
        "id": "md_items_per_row",
        "min": 1,
        "max": 6,
        "default": 4,
        "label": "t:sections.layout.products_per_row"
      },
      {
        "type": "header",
        "content": "t:sections.headers.tablet_layout"
      },
      {
        "type": "paragraph",
        "content": "t:sections.layout.display_type.tablet_paragraph"
      },
      {
        "type": "range",
        "id": "sm_items_per_row",
        "min": 1,
        "max": 4,
        "default": 4,
        "label": "t:sections.layout.products_per_row"
      },
      {
        "type": "header",
        "content": "t:sections.headers.mobile_layout"
      },
      {
        "type": "range",
        "id": "items_per_row",
        "min": 1,
        "max": 3,
        "default": 1,
        "label": "t:sections.layout.products_per_row"
      }
    ],
    "blocks": [
      {
        "type": "banner",
        "name": "t:sections.banners.label",
        "settings": [
          {
            "type": "paragraph",
            "content": "t:sections.banners.info"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.images.bg_image",
            "info": "t:sections.images.bg_image__info"
          },
          {
            "type": "video",
            "id": "video",
            "label": "t:sections.images.bg_video"
          },
          {
            "type": "range",
            "id": "nth_item",
            "label": "t:sections.banners.visibility.nth_item",
            "min": 0,
            "max": 50,
            "default": 3,
            "info": "t:sections.banners.visibility.nth_item__info"
          },
          {
            "type": "checkbox",
            "id": "only_on_first_page",
            "label": "t:sections.banners.visibility.only_on_first_page",
            "info" : "t:sections.banners.visibility.only_on_first_page__info",
            "default": true
          },
          {
            "type": "url",
            "id": "url",
            "label": "t:inputs.url.link"
          },
          {
            "type": "header",
            "content": "t:sections.headers.overlay_content"
          },
          {
            "type": "inline_richtext",
            "id": "title",
            "label": "t:inputs.text.title"
          },
          {
            "type": "select",
            "id": "title_style",
            "label": "t:sections.typography.style_options.heading_style_label",
            "default": "h3",
            "options": [
              {
                "value": "h3",
                "label": "t:inputs.text.title",
                "group": "t:sections.typography.style_options.text_group"
              },
              {
                "value": "body-text",
                "label": "t:sections.typography.style_options.body_text",
                "group": "t:sections.typography.style_options.text_group"
              },
              {
                "value": "subheading",
                "label": "t:inputs.text.subtitle",
                "group": "t:sections.typography.style_options.text_group"
              },
              {
                "value": "btn",
                "label": "t:sections.typography.style_options.primary_button",
                "group": "t:sections.typography.style_options.button_group"
              },
              {
                "value": "btn btn--secondary",
                "label": "t:sections.typography.style_options.secondary_button",
                "group": "t:sections.typography.style_options.button_group"
              },
              {
                "value": "btn btn--link",
                "label": "t:sections.typography.style_options.link",
                "group": "t:sections.typography.style_options.button_group"
              }
            ]
          },
          {
            "type": "select",
            "id": "content_alignment",
            "label": "t:sections.layout.position.heading_label",
            "default": "vertical-bottom horizontal-left",
            "options": [
              {
                "value": "vertical-top horizontal-left",
                "label": "t:sections.layout.position.options.top_left"
              },
              {
                "value": "vertical-top horizontal-center",
                "label": "t:sections.layout.position.options.top_center"
              },
              {
                "value": "vertical-top horizontal-right",
                "label": "t:sections.layout.position.options.top_right"
              },
              {
                "value": "vertical-center horizontal-left",
                "label": "t:sections.layout.position.options.middle_left"
              },
              {
                "value": "vertical-center horizontal-center",
                "label": "t:sections.layout.position.options.middle_center"
              },
              {
                "value": "vertical-center horizontal-right",
                "label": "t:sections.layout.position.options.middle_right"
              },
              {
                "value": "vertical-bottom horizontal-left",
                "label": "t:sections.layout.position.options.bottom_left"
              },
              {
                "value": "vertical-bottom horizontal-center",
                "label": "t:sections.layout.position.options.bottom_center"
              },
              {
                "value": "vertical-bottom horizontal-right",
                "label": "t:sections.layout.position.options.bottom_right"
              }
            ]
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "t:sections.colors.heading_color",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "overlay_color",
            "label": "t:sections.colors.overlay_color",
            "default": "#000000"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "label": "t:sections.colors.overlay_opacity",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%"
          },
          {
            "type": "header",
            "content": "t:sections.headers.desktop_layout"
          },
          {
            "type": "range",
            "id": "md_column_span",
            "label": "t:sections.banners.column_span.label",
            "min": 1,
            "max": 6,
            "default": 1,
            "info": "t:sections.banners.column_span.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.tablet_layout"
          },
          {
            "type": "range",
            "id": "sm_column_span",
            "label": "t:sections.banners.column_span.label",
            "min": 1,
            "max": 4,
            "default": 1,
            "info": "t:sections.banners.column_span.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.mobile_layout"
          },
          {
            "type": "range",
            "id": "column_span",
            "label": "t:sections.banners.column_span.label",
            "min": 1,
            "max": 3,
            "default": 1,
            "info": "t:sections.banners.column_span.info"
          }
        ]
      },
      {
        "name": "t:blocks.custom_spacing.name",
        "type": "custom_spacing",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "t:blocks.custom_spacing.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.desktop_layout"
          },
          {
            "type": "range",
            "id": "sm_margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          },
          {
            "type": "header",
            "content": "t:sections.headers.mobile_layout"
          },
          {
            "type": "range",
            "id": "margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          }
        ]
      }
    ]
  }
{% endschema %}