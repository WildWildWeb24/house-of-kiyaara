{%- liquid
  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign background_block = section.blocks | where: 'type', 'background' | first
  assign size_guide_block = section.blocks | where: 'type', 'size_guide' | first
  assign quantity_selector_block = section.blocks | where: 'type', 'quantity_selector' | first
  assign hotspot_blocks = section.blocks | where: 'type', 'hotspot'
  assign tab_blocks = section.blocks | where: 'type', 'tab'

  # Product form id
  # - Used to map inputs outside the form to the correct product form using form="{{ product_form_id }}" attribute
  # - Also used as a prefix in input ids and labels
  assign product_form_id = 'product-form-' | append: section.id

  # Preorder check
  assign is_preorder = false
  if product.tags contains 'Preorder' or product.tags contains 'preorder'
    assign is_preorder = true
  endif

  # Quantity selector and Multiply add related
  if quantity_selector_block
    assign has_quantity_selector = true
    assign quantity_next_to_add_to_cart = quantity_selector_block.settings.next_to_add_to_cart
  else
    assign has_quantity_selector = false
    assign quantity_next_to_add_to_cart = false
  endif

  # Size guide
  assign show_size_guide = false
  assign size_guide_trigger = size_guide_block.settings.size_guide_trigger | default: false
  assign size_guide_button_pos = ''

  if size_guide_block and size_guide_block.settings.image != blank or size_guide_block.settings.content != blank or size_guide_block.settings.page.content != blank
    if size_guide_trigger == blank or size_guide_trigger != blank and product.options contains size_guide_trigger
      assign show_size_guide = true

      # Size guide position
      if size_guide_trigger != blank and size_guide_block.settings.show_next_to_variant
        assign size_guide_button_pos = size_guide_trigger
      endif

      capture size_guide_button
        render 'block--product-size-guide-button', label: size_guide_block.settings.button_label, drawer_id: size_guide_block.id, show_ruler: size_guide_block.settings.show_ruler, button_position: size_guide_button_pos
      endcapture
    endif
  endif

  # Hotspot color
  if hotspot_blocks != blank
    assign hotspot_pos_array = hotspot_blocks[0].settings.hotspots_pos_array | split: '|'
    assign hotspot_aria_text = 'accessibility.product_hotspot' | t
  endif

  # Combined listing check
  assign product_for_media = product
  if product.id != product.selected_or_first_available_variant.product.id and product.selected_or_first_available_variant != blank
    assign product_for_media = product.selected_or_first_available_variant.product
  endif

  # For tabs
  assign tab_rendered = false

  # For product actions bar
  assign show_actions_bar = false
  assign show_actions = false
  if section.settings.show_breadcrumb or hotspot_blocks.size > 0 or product.media.size > 1
    assign show_actions_bar = true
  endif
  if hotspot_blocks.size > 0 or product.media.size > 1
    assign show_actions = true
  endif

  # Tablet variables
  assign tablet_content_split = false
  if section.settings.image_position == 'center' and section.settings.tablet_single_column == false
    assign tablet_content_split = true
  endif

  # Desktop layout variables
  # - The right column is used only when image is in center position.
  # - Variable defaults are set for left position.
  assign single_content_column = true
  assign desktop_grid_columns = 2
  assign image_column_start = 1
  assign image_column_span = section.settings.image_size
  assign left_content_column_span = 12 | minus: image_column_span
  assign right_content_column_span = 0
  assign left_content_grid_column = 'span ' | append: left_content_column_span | append: ' / -1'

  case section.settings.image_position
    when 'right'
      assign image_column_start = 13 | minus: image_column_span
      assign left_content_grid_column = '1 / span ' | append: left_content_column_span
    when 'center'
      assign single_content_column = false
      assign desktop_grid_columns = 3
      assign content_columns_total = 12 | minus: image_column_span
      assign left_content_column_span = content_columns_total | times: 0.5 | round
      assign right_content_column_span = content_columns_total | minus: left_content_column_span
      assign image_column_start = left_content_column_span | plus: 1

      if section.settings.image_offset != 0
        assign left_content_column_span = left_content_column_span | plus: section.settings.image_offset
        assign right_content_column_span = right_content_column_span | minus: section.settings.image_offset
        assign image_column_start = image_column_start | plus: section.settings.image_offset
      endif

      if section.settings.allow_overlap
        assign left_content_column_span = left_content_column_span | plus: 1
        assign right_content_column_span = right_content_column_span | plus: 1
      endif

      assign left_content_grid_column = '1 / span ' | append: left_content_column_span
      assign right_content_grid_column = 'span ' | append: right_content_column_span | append: ' / -1'
  endcase

  # Heading size modifiers
  assign heading_size_modifiers = 'size--default sm-size--default'
-%}

{% if tab_blocks.size > 0 -%}
  {{ 'component-tabs.css' | asset_url | stylesheet_tag }}
{%- endif %}
{% if hotspot_blocks.size > 0 -%}
  {{ 'component-hotspots.css' | asset_url | stylesheet_tag }}
{%- endif %}
{{ 'template-product--big-image.css' | asset_url | stylesheet_tag: preload: true }}

{% assign left_column_inner_html = '' %}
{% assign right_column_inner_html = '' %}

{%- for block in section.blocks -%}
  {%- liquid
    if block.type == 'custom_spacing' or block.type == 'background'
      continue
    endif

    capture block_inner_html
      case block.type
        when '@app'
          render block
        when 'text'
          render 'block--richtext', block: block
        when 'title'
          render 'block--product-title', block: block
          assign heading_size_modifiers = block.settings.size_multiplier | append: ' ' | append: block.settings.sm_size_multiplier
        when 'price'
          render 'block--product-price', block: block
        when 'description'
          render 'block--product-description', collapsible: block.settings.enable_collapsible, collapsible_as_drawer: section.settings.open_as_drawer, block: block
        when 'custom_liquid'
          echo block.settings.custom_liquid
        when 'collapsible_tab'
          render 'block--product-collapsible-tab', block: block
        when 'sibling_products'
          render 'block--product-sibling-products', block: block
        when 'quantity_selector'
          if block.settings.next_to_add_to_cart
            continue
          endif
          render 'block--product-quantity-selector', product_form_id: product_form_id
        when 'share'
          render 'block--product-share-button', block: block
        when 'variant_picker'
          unless product.has_only_default_variant
            render 'product-variant-picker', product_form_id: product_form_id, section_id: section.id, cross_out_unavailable: block.settings.cross_out_unavailable, picker_type: block.settings.picker_type, is_preorder: is_preorder, update_url: true, size_guide_button_pos: size_guide_button_pos, size_guide_button: size_guide_button, big_image_media: true, swatch: block.settings.swatch
          endunless
        when 'size_guide'
          if show_size_guide and size_guide_button_pos == blank
            echo size_guide_button
          endif
        when 'buy_buttons'
          render 'block--product-buy-buttons', product_form_id: product_form_id, block: block, is_preorder: is_preorder, has_quantity_selector: has_quantity_selector, quantity_next_to_add_to_cart: quantity_next_to_add_to_cart
        when 'rating'
          echo 'component-rating.css' | asset_url | stylesheet_tag
          render 'rating'
        when 'inventory'
          render 'block--product-inventory-status', block: block, current_variant: product.selected_or_first_available_variant
        when 'similar_collections'
          render 'block--product-similar-collections', block: block
        when 'pickup_availability'
          render 'block--product-pickup-availability'
                when 'icons'
          if block.settings.first_image != blank or block.settings.second_image != blank or block.settings.third_image != blank or block.settings.fourth_image != blank or block.settings.fifth_image != blank or block.settings.sixth_image != blank or block.settings.seventh_image != blank or block.settings.eight_image != blank
            render 'block--product-icons-grid', block: block
          endif
        when 'sku'
          render 'block--product-sku'
        when 'upsell_products'
          if block.settings.upsell_product_1 != blank or block.settings.upsell_product_2 != blank or block.settings.upsell_product_3 != blank or block.settings.upsell_product_4 != blank
          render 'product-template-upsell', product_form_id: product_form_id, block: block, is_preorder: is_preorder, heading_size_modifiers: heading_size_modifiers
          endif
        when 'badges'
          render 'product-badges', product: product, show_badges: true, use_variant_price: true
        when 'tab'
          # All tabs rendered when first tab is found
          unless tab_rendered
            render 'tabs', blocks: tab_blocks
            assign tab_rendered = true
          endunless
        when 'vendor'
          render 'block--product-vendor', enable_vendor_link: block.settings.enable_vendor_link
        when 'property_bars'
          render 'block--property-bars', block: block
        when 'same_day_pincode_checker'
            render 'block--same-day-pincode-checker', block: block
        endcase
    endcapture
  -%}

  {%- if block_inner_html != blank -%}
    {% capture block_html %}
      <div class="product-block sm-mt mt block--{{ block.type | escape | remove: '@' | replace: '_', '-' }}" style="--mt: {{ block.settings.margin_top | append: 'px' }}; --sm-mt: {{ block.settings.sm_margin_top | append: 'px' }}" {{ block.shopify_attributes }}>
        {{ block_inner_html }}
      </div>
    {% endcapture %}

    {%- if single_content_column -%}
      {% assign left_column_inner_html = left_column_inner_html | append: block_html %}
    {%- elsif block.settings.block_column != 'right' -%}
      {% assign left_column_inner_html = left_column_inner_html | append: block_html %}
    {% else %}
      {% assign right_column_inner_html = right_column_inner_html | append: block_html %}
    {%- endif -%}
  {%- endif -%}
{% endfor %}

<div
  id="{{ section.id }}"
  class="container no-default-padding sm-down-edge-to-edge section-spacing color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
    style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {% else %}
    style="--sm-pt: 12px; --sm-pb: var(--gutter);"
  {%- endif %}
>
  {% if background_block %}
    {% render 'block--section-background', block: background_block, height_unit: 'px' %}
  {% endif %}

  <div class="big-image-product-layout">
    {% if show_actions_bar %}
    <div class="product-actions-bar flex horizontal sm-pb-12">
      {% if section.settings.show_breadcrumb %}
        {% render 'breadcrumb' %}
      {% endif %}
      {% if show_actions %}
        {% capture product_action_buttons %}
        <nav class="product-action-buttons flex horizontal sm-down-hide">
          {% if hotspot_blocks.size > 0 %}
            <button
              type="button"
              aria-controls="modal-{{ section.id }}"
              data-open="modal-{{ section.id }}"
              class="text-button size--small subheading flex pt-8 pb-8"
              aria-label="{{ 'accessibility.product_hotspots_open' | t }}"
            >
              {{ 'products.product.quick_links.highlights' | t }}
              {% render 'icon-plus--small' %}
            </button>
          {% endif %}
          {% if product.media.size > 1 %}
            <button
              type="button"
              aria-controls="modal--zoom-gallery-big-image-gallery"
              data-open="modal--zoom-gallery-big-image-gallery"
              class="text-button size--small subheading flex pt-8 pb-8"
              aria-label="{{ 'accessibility.product_images_gallery_open' | t }}"
            >
              {{ 'products.product.quick_links.gallery' | t }}
              {% render 'icon-plus--small' %}
            </button>
            {% endif %}
          </nav>
        {% endcapture %}
        {{ product_action_buttons }}
      {% endif %}
    </div>
    {% endif %}
    <div class="grid grid--product-main-content desktop-grid-columns-{{ desktop_grid_columns }} {%- if tablet_content_split %} tablet--content-columns-split {%- endif %} {%- if section.settings.extend_tablet_breakpoint %} tablet--extend-breakpoint {%- endif %}">
      <div id="big-image-{{ section.id }}" class="media-area sm-down-p-page" style="--md-media-column-start: {{ image_column_start }}; --md-media-column-span: {{ image_column_span }};">
        <div class="hotspot-container br-img" style="--image-background: {{ section.settings.image_background }};">
          {% liquid
            # Sizes attr calculations
            case section.settings.image_size
              when 'small'
                assign sizes_fraction = '5 / 12'
              when 'medium'
                assign sizes_fraction = '6 / 12'
              when 'large'
                assign sizes_fraction = '7 / 12'
              else
                assign sizes_fraction = '8 / 12'
            endcase

            assign big_image_sizes = '(max-width: 767px) 100vw, (max-width: 1023px) calc(10 / 12 * 100wv), calc([sizes_fraction] * 100vw)' | replace: '[sizes_fraction]', sizes_fraction

            # Defining what image to use
            if product.has_only_default_variant
              assign big_image = product_for_media.featured_image
            elsif product_for_media.selected_or_first_available_variant.featured_media
              assign big_image = product_for_media.selected_or_first_available_variant.featured_media
            else
              assign big_image = product_for_media.featured_image
            endif
          -%}
          {% render 'picture',
            image_default: big_image,
            aspect_ratio: section.settings.product_image_aspect_ratio,
            sizing_rule: section.settings.media_fill_rule,
            sizes: big_image_sizes,
            preload: true
          %}

          {%- for block in hotspot_blocks -%}
            {% if hotspot_pos_array != blank %}
              {% assign current_pos = hotspot_pos_array[forloop.index0] | split: ',' %}
              {% assign title_position = current_pos[0] %}
              {% assign horizontal_position = current_pos[1] %}
              {% assign vertical_position = current_pos[2] %}
            {% else %}
              {% assign title_position = block.settings.title_position %}
              {% assign vertical_position = block.settings.vertical_position %}
              {% assign horizontal_position = block.settings.horizontal_position %}
            {% endif %}
            <button
              type="button"
              aria-haspopup="dialog"
              aria-controls="modal-{{ section.id }}"
              data-open="modal-{{ section.id }}?slide={{ forloop.index }}"
              aria-label="{{ block.settings.title | append: ' ' | append: hotspot_aria_text | replace: '[br]', ' ' }}"
              class="hotspot animated color--{{ section.settings.color_hotspot }} {%- if section.settings.numbered_hotspots %} hotspot--number{% endif %}"
              {{ block.shopify_attributes }}
              style="
                --hotspot-vertical-position: {{ vertical_position }}%;
                --hotspot-horizontal-position: {{ horizontal_position }}%;
              "
            >
              {%- if section.settings.numbered_hotspots -%}
                <span class="hotspot-dot">
                  {{- forloop.index -}}
                </span>
              {%- else -%}
                <span class="hotspot-dot">
                  {%- render 'icon-plus' -%}
                </span>
              {%- endif %}
              {%- if block.settings.title != blank -%}
                <span class="hotspot-title position--{{ title_position }} size--tiny sm-down-hide">
                  {{- block.settings.title | replace: '[br]', '<br>' -}}
                </span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
      {% if show_actions %}
        {{ product_action_buttons | replace_first: 'product-action-buttons flex horizontal sm-down-hide', 'product-action-buttons --mobile flex horizontal sm-hide p-page' }}
      {% endif %}
      {% if left_column_inner_html != blank %}
        <div class="content-column content-column--left sm-down-p-page" style="--content-grid-column: {{ left_content_grid_column }}; --custom-mt: {{ section.settings.first_content_column_top_margin | append: 'px' }};">
          {{ left_column_inner_html }}
        </div>
      {% endif %}
      {% if right_column_inner_html != blank %}
        <div class="content-column content-column--right flex vertical sm-down-p-page" style="--content-grid-column: {{ right_content_grid_column }}; --custom-mt: {{ section.settings.second_content_column_top_margin | append: 'px' }};">
          {{ right_column_inner_html }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{%- liquid
  # Sticky buy bar
  if section.settings.sticky_buy_bar
    render 'product-buy-bar', product_form_id: product_form_id, product_image_aspect_ratio: section.settings.product_image_aspect_ratio, is_preorder: is_preorder, color_scheme: section.settings.sticky_buy_bar_color_scheme
  endif

  # Collapsible tabs that are set as drawers are loaded here so they are properly aligned on the DOM tree and do not cause any layout issues.
  if section.settings.open_as_drawer
    assign collapsible_blocks = section.blocks | where: 'type', 'collapsible_tab'
    for block in collapsible_blocks
      if block.settings.content != empty or block.settings.page.content != blank
        assign collapsible_id = 'Details-' | append: block.id | append: '-' | append: section.id
        assign size_multipliers = block.settings.size_multiplier | append: ' ' | append: block.settings.sm_size_multiplier
        render 'drawer-tabs', drawer_id: collapsible_id, title: block.settings.title, text: block.settings.content, page: block.settings.page, custom_liquid: block.settings.custom_liquid, size_multipliers: size_multipliers
      endif
    endfor

    assign description_block = section.blocks | where: 'type', 'description' | first
    if description_block and description_block.settings.enable_collapsible
      assign collapsible_id = 'Details-' | append: description_block.id | append: '-' | append: section.id
      assign description_title = 'products.product.description' | t
      assign size_multipliers = description_block.settings.size_multiplier | append: ' ' | append: description_block.settings.sm_size_multiplier
      render 'drawer-tabs', drawer_id: collapsible_id, title: description_title, text: product.description, size_multipliers: size_multipliers
    endif
  endif

  # Size guide block
  if show_size_guide
    render 'drawer-tabs', drawer_id: size_guide_block.id, title: size_guide_block.settings.button_label, text: size_guide_block.settings.content, page: size_guide_block.settings.page, image: size_guide_block.settings.image
  endif

  if hotspot_blocks.size > 0
    render 'modal-slider', modal_slides: hotspot_blocks
  endif
-%}
<script type="text/javascript" src="{{ 'section-product.js' | asset_url }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Section class toggle to hide and show hotspots text
    const sectionElement = document.getElementById('{{ section.id }}');

    if (sectionElement) {
      const handleScroll = () => {
        const rect = sectionElement.getBoundingClientRect();
        const offset = -100; // 200px above the viewport top

        if (rect.top <= offset) {
          sectionElement.classList.add('scrolled-past-top');
        } else {
          sectionElement.classList.remove('scrolled-past-top');
        }
      };

      const throttledHandleScroll = throttle(handleScroll, 60); // Adjust the interval as needed
      document.addEventListener('scroll', throttledHandleScroll);
    }

    // Swipe handler to open gallery modal
    const bigImage = document.getElementById('big-image-{{ section.id }}'),
      theProductGallery = document.getElementById('modal--zoom-gallery-big-image-gallery');

    if (theProductGallery) {
      bigImage.addEventListener('touchstart', function (event) {
        touchStartX = event.touches[0].clientX; // Get X position on touch start
      });

      bigImage.addEventListener('touchend', function (event) {
        touchEndX = event.changedTouches[0].clientX; // Get X position on touch end
        handleSwipe();
      });

      function handleSwipe() {
        const swipeThreshold = 50; // Minimum swipe distance to be considered a swipe

        if (touchEndX < touchStartX - swipeThreshold) {
          console.log('Swiped Left');
          Woolman.ModalsAndDrawers.showModalOrDrawer('modal--zoom-gallery-big-image-gallery');
        } else if (touchEndX > touchStartX + swipeThreshold) {
          console.log('Swiped Right');
          Woolman.ModalsAndDrawers.showModalOrDrawer('modal--zoom-gallery-big-image-gallery');
        }
      }
    }
  });
</script>

<script>
  // Store product handles to history for "recently-viewed" section.
  (function () {
    const history = sessionStorage.getItem('Woolman_Product_History')
      ? sessionStorage.getItem('Woolman_Product_History').split(',')
      : [];
    const productHandle = window.location.pathname.split('/').pop();
    if (!productHandle) return;

    if (history.includes(productHandle)) {
      // remove from the list to add first in line again
      let indexToRemove = history.indexOf(productHandle);
      if (indexToRemove !== -1) {
        // Remove the item using splice
        history.splice(indexToRemove, 1);
      }
    } else if (history.length >= 10) {
      // only store up to 10 recently viewed products
      history.pop();
    }

    // Add the new item to the array start
    history.unshift(productHandle);
    sessionStorage.setItem('Woolman_Product_History', history.join(','));
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "class": "section--main-product ignore-section-animation main-product",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-product-big-image.info"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:inputs.checkbox.show_breadcrumb",
      "info": "t:inputs.checkbox.show_breadcrumb_info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "t:sections.colors.color_scheme.label"
    },
    {
      "id": "product_image_aspect_ratio",
      "type": "select",
      "label": "t:sections.main-product.settings.product_image_aspect_ratio.label",
      "options": [
        {
          "value": "natural",
          "label": "t:sections.images.aspect_ratio.natural"
        },
        {
          "value": "portrait",
          "label": "t:sections.images.aspect_ratio.portrait_2_3"
        },
        {
          "value": "portrait_alt",
          "label": "t:sections.images.aspect_ratio.portrait_3_4"
        },
        {
          "value": "square",
          "label": "t:sections.images.aspect_ratio.square"
        },
        {
          "value": "landscape",
          "label": "t:sections.images.aspect_ratio.landscape_4_3"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "media_fill_rule",
      "label": "t:sections.images.fill_rule.label",
      "options": [
        {
          "value": "cover",
          "label": "t:sections.images.fill_rule.cover"
        },
        {
          "value": "contain",
          "label": "t:sections.images.fill_rule.contain"
        }
      ],
      "default": "contain"
    },
    {
      "type": "color_background",
      "id": "image_background",
      "label": "t:sections.main-product-big-image.image_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.headers.desktop_layout",
      "info": "t:sections.main-product-big-image.desktop_layout_info"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.main-product-big-image.image_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.main-product-big-image.image_position.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.main-product-big-image.image_position.options.center"
        },
        {
          "value": "right",
          "label": "t:sections.main-product-big-image.image_position.options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_offset",
      "visible_if": "{{ section.settings.image_position == 'center' }}",
      "label": "t:sections.main-product-big-image.image_offset.label",
      "default": 0,
      "min": -1,
      "max": 1,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "allow_overlap",
      "visible_if": "{{ section.settings.image_position == 'center' }}",
      "label": "t:sections.main-product-big-image.allow_overlap.label",
      "default": false
    },
    {
      "id": "image_size",
