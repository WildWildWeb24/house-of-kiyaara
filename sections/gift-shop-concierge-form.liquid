{{ 'page-gift-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'GiftConciergeForm__' | append: section.id
  assign qty_options = section.settings.quantity_options | default: '10-20, 21-30, 30+' | split: ','
-%}

{% render 'section-custom-colors', section: section %}
<div
  id="{{ section.id }}"
  class="gift-concierge-section color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sm-pt: {{ section.settings.md_padding_top }}px; --sm-pb: {{ section.settings.md_padding_bottom }}px;">
  <div class="container">
    <div class="gift-concierge__card">
      {%- comment -%} Left Column: Heading, Description, and Optional Direct Contact Links {%- endcomment -%}
      <div class="gift-concierge__info">
        {%- if section.settings.subtitle != blank -%}
          <p class="subheading gift-concierge__eyebrow">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="gift-concierge__title {{ section.settings.heading_size }}">
            {{ section.settings.title | replace: '[br]', '<br/>' }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="gift-concierge__desc rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_contact_cards and section.blocks.size > 0 -%}
          <div class="gift-concierge__contacts">
            {%- for block in section.blocks -%}
              <a
                href="{{ block.settings.button_link }}"
                class="gift-concierge__contact-btn gift-concierge__contact-btn--{{ block.settings.icon_type }}"
                {% if block.settings.button_sublabel != blank %}data-sublabel="{{ block.settings.button_sublabel | escape }}"{% endif %}
                {{ block.shopify_attributes }}>
                <span class="gift-concierge__contact-value">{{ block.settings.button_label | escape }}</span>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Column: CRM Inquiry Form {%- endcomment -%}
      <div class="gift-concierge__form-wrap">
        {%- form 'contact', id: form_id, class: 'gift-concierge__form' -%}
          <input type="hidden" name="contact[form_type_source]" value="Kiyaara Gift Shop CRM Inquiry">
          <input type="hidden" name="contact[recipient_email]" value="{{ section.settings.recipient_email | default: 'hello@houseofkiyaara.com' | escape }}">

          {%- if form.posted_successfully? -%}
            <div class="gift-concierge__alert gift-concierge__alert--success" tabindex="-1" autofocus>
              {{ section.settings.success_message | default: "Thank you! We've received your gifting inquiry and will get back to you shortly." }}
            </div>
          {%- elsif form.errors -%}
            <div class="gift-concierge__alert gift-concierge__alert--error" role="alert" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="gift-concierge__form-grid">
            <div class="gift-concierge__field">
              <label class="gift-concierge__label" for="{{ form_id }}-name">
                {{ section.settings.name_label | default: 'Name' | escape }} <span aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="{{ form_id }}-name"
                name="contact[name]"
                class="gift-concierge__input"
                placeholder="{{ section.settings.name_placeholder | default: 'Your full name' | escape }}"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                autocomplete="name"
                required>
            </div>

            <div class="gift-concierge__field">
              <label class="gift-concierge__label" for="{{ form_id }}-phone">
                {{ section.settings.phone_label | default: 'Contact' | escape }} <span aria-hidden="true">*</span>
              </label>
              <input
                type="tel"
                id="{{ form_id }}-phone"
                name="contact[phone]"
                class="gift-concierge__input"
                placeholder="{{ section.settings.phone_placeholder | default: '+91 98765 43210' | escape }}"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                autocomplete="tel"
                required>
            </div>

            <div class="gift-concierge__field">
              <label class="gift-concierge__label" for="{{ form_id }}-email">
                {{ section.settings.email_label | default: 'Email ID' | escape }} <span aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                class="gift-concierge__input"
                placeholder="{{ section.settings.email_placeholder | default: 'you@example.com' | escape }}"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                required>
            </div>

            <div class="gift-concierge__field">
              <label class="gift-concierge__label" for="{{ form_id }}-quantity">
                {{ section.settings.quantity_label | default: 'Order quantity' | escape }} <span aria-hidden="true">*</span>
              </label>
              <div class="gift-concierge__select-wrap">
                <select
                  id="{{ form_id }}-quantity"
                  name="contact[order_quantity]"
                  class="gift-concierge__select"
                  required>
                  <option value="" disabled selected>{{ section.settings.quantity_placeholder | default: 'Select quantity' | escape }}</option>
                  {%- for opt in qty_options -%}
                    {%- assign clean_opt = opt | strip -%}
                    {%- if clean_opt != blank -%}
                      <option value="{{ clean_opt | escape }}">{{ clean_opt | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
                <span class="gift-concierge__select-arrow" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="gift-concierge__field gift-concierge__field--full">
              <label class="gift-concierge__label" for="{{ form_id }}-body">
                {{ section.settings.message_label | default: 'Describe your request' | escape }} <span aria-hidden="true">*</span>
              </label>
              <textarea
                id="{{ form_id }}-body"
                name="contact[body]"
                rows="4"
                class="gift-concierge__textarea"
                placeholder="{{ section.settings.message_placeholder | default: 'Tell us about your occasion, delivery timeline, and any customisation requirements...' | escape }}"
                required>{{- form.body -}}</textarea>
            </div>
          </div>

          <div class="gift-concierge__submit-wrap">
            <button type="submit" class="gift-concierge__submit-btn">
              <span>{{ section.settings.submit_label | default: 'SUBMIT' | escape }}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift shop concierge form",
  "tag": "section",
  "class": "section-gift-concierge-form",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Let's plan your gifting"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Tell us what you have in mind and we'll take it from there. Share your details to customise your gifts.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_contact_cards",
      "label": "Show direct contact buttons (Email / WhatsApp / Call)",
      "default": true
    },
    {
      "type": "header",
      "content": "CRM form fields"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient notification email",
      "default": "hello@houseofkiyaara.com",
      "info": "Submissions are sent via Shopify Contact notifications to your store email (hello@houseofkiyaara.com)."
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name field label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your full name"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Contact field label",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Contact placeholder",
      "default": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email ID"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Order quantity label",
      "default": "Order quantity"
    },
    {
      "type": "text",
      "id": "quantity_placeholder",
      "label": "Order quantity placeholder",
      "default": "Select quantity"
    },
    {
      "type": "text",
      "id": "quantity_options",
      "label": "Order quantity dropdown options (comma-separated)",
      "default": "10-20, 21-30, 30+"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Request textarea label",
      "default": "Describe your request"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Request textarea placeholder",
      "default": "Tell us about your occasion, delivery timeline, and any customisation requirements..."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "SUBMIT"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We've received your gifting request and will reach out to you shortly."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 56
    },
    {
      "type": "header",
      "content": "Custom colors & borders"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "custom_card_bg_color",
      "label": "Card / inner box background color"
    },
    {
      "type": "color",
      "id": "custom_border_color",
      "label": "Section divider border color"
    },
    {
      "type": "color",
      "id": "custom_card_border_color",
      "label": "Card / inner box border color"
    },
    {
      "type": "range",
      "id": "custom_border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Accent & subheading color"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Heading text color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "custom_btn_bg_color",
      "label": "Submit button background color"
    },
    {
      "type": "color",
      "id": "custom_btn_text_color",
      "label": "Submit button text color"
    },
    {
      "type": "color",
      "id": "custom_btn_border_color",
      "label": "Submit button border color"
    }
  ],
  "blocks": [
    {
      "type": "contact_card",
      "name": "Direct contact button",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon type",
          "options": [
            { "value": "email", "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "phone", "label": "Phone" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "button_sublabel",
          "label": "Small top label",
          "default": "EMAIL US AT"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Main contact text",
          "default": "hello@houseofkiyaara.com"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Contact link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift shop concierge form"
    }
  ]
}
{% endschema %}
