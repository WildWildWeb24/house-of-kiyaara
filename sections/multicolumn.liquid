<style>
@media screen and (max-width: 749px) {
  .grid.gridy-track {
    --gap: 0px !important;
    row-gap: 0px !important;
  }

  .the-siblings .gridy-track {
    --gap: 8px !important;
    row-gap: 8px !important;
  }
}
    .multicolumn-item.standard-items-spacing {
      padding-bottom: 0 !important;
      margin-bottom: 16px !important;
    }

    .multicolumn-item .blocks-title {
      margin-top: 12px !important;
      margin-bottom: 8px !important;
    }

    .multicolumn-item .blocks-rte {
      margin-bottom: 0 !important;
    }
  }

</style>
{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign background_block = section.blocks | where: 'type', 'background' | first
  assign column_blocks = section.blocks | where: 'type', 'column'

  # Variables
  assign ipr_desktop = section.settings.items_per_row_desktop
  assign ipr_tablet = section.settings.items_per_row_tablet
  assign ipr_mobile = 1
  assign sizes_ipr_mobile = ipr_mobile
  assign slider_mobile = false
  assign slider_desktop = false
  assign slide_peek = false
  assign slider_items_count = column_blocks | size
  assign aspect_ratio = section.settings.media_aspect_ratio | append: ' sm-' | append: section.settings.sm_media_aspect_ratio

  if section.settings.layout_mobile contains 'slide'
    assign slider_mobile = true
  endif
  if section.settings.layout_desktop == 'slide'
    assign slider_desktop = true
  endif

  if section.settings.layout_mobile contains 'peek'
    assign slide_peek = true
    assign sizes_ipr_mobile = ipr_mobile | plus: 0.5
  endif

  capture sizes
    render 'img_sizes', ipr_mobile: sizes_ipr_mobile, ipr_tablet: ipr_tablet, ipr_desktop: ipr_desktop
  endcapture
-%}

{% render 'section-custom-colors', section: section %}
<div
  id="{{ section.id }}"
  class="container section-spacing sm-down-edge-to-edge color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>

  {% if background_block %}
    {% render 'block--section-background', block: background_block %}
  {% endif %}

  <gridy-slider
    id="slider-{{ section.id }}"
    class="gridy-slider"
    data-mobile-enabled="{{ slider_mobile }}"
    data-tablet-enabled="{{ slider_desktop }}"
    data-desktop-enabled="{{ slider_desktop }}"
    data-ipr-desktop="{{ ipr_desktop }}"
    data-ipr-tablet="{{ ipr_tablet }}"
    data-ipr-mobile="{{ ipr_mobile }}"
    data-arrows="true"
    data-progress-bar="true"
    data-sliding-behavior="{{ section.settings.sliding_behavior }}"
    data-autoplay="{{ section.settings.autoplay}}"
    data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}">
    <div class="grid gridy-track scrollbar--hide grid-cols-{{ ipr_mobile }} sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}{% if slider_mobile %} track-inner-padding{% endif %}{% if slide_peek %} slide-peek{% endif %}">
      {% for block in column_blocks %}
        <div class="multicolumn-item standard-items-spacing p-gutter sm-p-0 text-align-{{ section.settings.alignment }}" {{ block.shopify_attributes }}>
          {% if block.settings.video != blank -%}
            <div class="column-media br-img">
              {%- render 'video_new',
              video_default: block.settings.video,
              aspect_ratio: aspect_ratio,
              autoplay: block.settings.video_autoplay,
              controls: block.settings.video_controls -%}
            </div>
          {% elsif block.settings.image != blank -%}
            <div class="column-media br-img">
              {%- render 'picture',
                image_default: block.settings.image,
                aspect_ratio: aspect_ratio,
                sizes: sizes,
                preload: preload_media -%}
            </div>
          {%- endif %}
          
          {% if block.settings.press_date != blank or block.settings.press_logo != blank %}
          <div
            class="kiyaara-press-meta"
            style="display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;width:100%;"
          >
          {% if block.settings.press_date != blank %}
          <span
            class="kiyaara-press-date"
            style="margin:0!important;padding:0!important;align-self:center!important;font-size:12px;line-height:1.4;color:#777;text-align:left;"
          >
          {{ block.settings.press_date | escape }}
          </span>
          {% endif %}

          {% if block.settings.press_logo != blank %}
          {{
            block.settings.press_logo
              | image_url: width: 240
              | image_tag:
            class: 'kiyaara-press-logo',
            loading: 'lazy',
            style: 'display:block!important;flex:0 0 auto!important;width:auto!important;height:44px!important;max-width:120px;max-height:none!important;margin:0 0 0 auto!important;padding:0!important;align-self:center!important;object-fit:contain;'
          }}
           {% endif %}
           </div>
          {% endif %}

            {% if block.settings.title -%}
              <h2 class="blocks-title">{{ block.settings.title | replace: '[br]', '<br>' }}</h2>
            {%- endif %}
            {% if block.settings.text -%}
              <div class="blocks-rte rte">{{ block.settings.text }}</div>
            {%- endif %}
            {% if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <div>
                {%- render 'button',
                  label: block.settings.button_label,
                  link: block.settings.button_link,
                  style: block.settings.button_style -%}
              </div>
            {%- endif %}
            {% if block.settings.button_2_label != blank and block.settings.button_2_link != blank -%}
              <div>
                {%- render 'button',
                  label: block.settings.button_2_label,
                  link: block.settings.button_2_link,
                  style: block.settings.button_2_style -%}
              </div>
            {%- endif %}
        </div>
      {% endfor %}
    </div>

    {%- liquid
      assign arrows_hide_class = ''
      if slider_items_count <= ipr_desktop
        assign arrows_hide_class = arrows_hide_class | append: ' md-hide'
      endif
      if slider_items_count <= ipr_tablet
        assign arrows_hide_class = arrows_hide_class | append: ' sm-to-md-hide'
      endif
      if slider_items_count <= ipr_mobile
        assign arrows_hide_class = arrows_hide_class | append: ' sm-down-hide'
      endif

      render 'gridy-arrows-and-progress', class: arrows_hide_class, ipr_desktop: ipr_desktop, ipr_tablet: ipr_tablet, ipr_mobile: ipr_mobile, items_count: slider_items_count
    -%}
  </gridy-slider>

</div>

