{%- assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first -%}
{%- assign newsletter_block = section.blocks | where: 'type', 'email_form' | first -%}
{%- assign skip_types = 'image,email_form' | split: ',' %}

{% capture content %}
  {%- render 'content-blocks', skip: skip_types -%}
{% endcapture %}

{% capture newsletter %}
  {%- if newsletter_block -%}
    <div {{ newsletter_block.shopify_attributes }} class="mt sm-mt" style="--mt: {{ newsletter_block.settings.margin_top | append: 'px' }}; --sm-mt: {{ newsletter_block.settings.sm_margin_top | append: 'px' }}">
      {%- render 'newsletter-form', section_id: section.id, additional_info: newsletter_block.settings.additional_info -%}
    </div>
  {%- endif -%}
{% endcapture %}

<div id="NewsletterSection-{{ section.id }}" class="newsletter-{{ section.id }} container color-{{ section.settings.color_scheme }} section-spacing"
{% if custom_spacing -%}
style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
{%- endif %}>
  <div class="grid vertical-center">
    {% case section.settings.text_alignment %}
      {% when 'left' %}
        {% if section.settings.justify_on_desktop %}
          <div class="col-12 col-sm-6 text-align-left">
            {{ content }}
          </div>
          <div class="col-12 col-sm-6 col-md-5 col-md-offset-8">
            {{ newsletter }}
          </div>
        {% else %}
            <div class="col-12 col-sm-6 text-align-left">
              {{ content }}
              {{ newsletter }}
            </div>
        {% endif %}
      {% when 'center' %}
        <div class="col-12 col-sm-6 col-sm-offset-4 text-align-center">
          {{ content }}
          {{ newsletter }}
        </div>
      {% when 'right' %}
        {% if section.settings.justify_on_desktop %}
          <div class="col-12 col-sm-6 col-md-offset-7 col-sm-order-2 text-align-right">
            {{ content }}
          </div>
          <div class="col-12 col-sm-6 col-md-5 col-sm-order-1">
            {{ newsletter }}
          </div>
        {% else %}
          <div class="col-12 col-sm-6 col-md-offset-7 col-sm-order-2 text-align-right">
            {{ content }}
            {{ newsletter }}
          </div>
        {% endif %}
    {% endcase %}
  </div>
</div>

