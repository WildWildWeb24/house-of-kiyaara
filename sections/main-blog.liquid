{%- liquid
  assign ipr_desktop = section.settings.md_items_per_row
  assign ipr_tablet = section.settings.sm_items_per_row
  assign ipr_mobile = 1
  assign ipr_array = ipr_mobile | append: ',' | append: ipr_tablet | append: ',' | append: ipr_desktop | split: ','

  # Sizes attribute
  capture sizes
    render 'img_sizes', ipr_mobile: ipr_mobile, ipr_tablet: ipr_tablet, ipr_desktop: ipr_desktop
  endcapture

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first


  # Section index check
  assign items_to_preload = ipr_desktop | times: 2
  if section.index < 3 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif
-%}

{{ 'template-blog.css' | asset_url | stylesheet_tag }}
<script type="text/javascript" defer src="{{ 'template-blog.js' | asset_url }}"></script>

<div
  id="{{section.id}}"
  class="container section-spacing color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div class="m-auto{% if ipr_desktop == 2 %} col-md-max-8{% endif %}">
    {%- if section.settings.show_blog_title or section.settings.enable_filtering and blog.all_tags.size > 0 -%}
    <header class="mb-gutter mt-40 mb-40">
      {%- if section.settings.show_blog_title -%}
      <h1 class="heading mb-16 {% if section.settings.center_text %} text-align-center{% endif %}">{{ blog.title }}</h1>
      {%- endif -%}

      {%- if section.settings.enable_filtering and blog.all_tags.size > 0 -%}
      <div class="blog-filters{% if section.settings.center_text %} m-auto{% endif %}">
        <link-dropdown>
          <select id="filter-by" class="btn size--small filter-select" data-blog-url="{{blog.url}}" aria-label="{{ 'accessibility.blog_filter_by' | t }}">
            <option value="" {% unless current_tags %}selected="selected"{% endunless %}>
              {{- 'blogs.article.show_all' | t -}}
            </option>
            {%- for tag in blog.all_tags -%}
              {%- if current_tags contains tag -%}
                {%- assign tag_handle = tag | handleize -%}
                <option value="{{ tag_handle }}" selected="selected">
                  {{- tag -}}
                </option>
              {%- else -%}
                {%- assign tag_handle = tag | handleize -%}
                <option value="{{ tag_handle }}">
                  {{- tag -}}
                </option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          <span class="link-icon select-icon dropmenu-arrow icon--round">{% render 'icon-caret' %}</span>
        </link-dropdown>
      </div>
      {%- endif -%}
    </header>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.posts_per_page -%}
      <div style="--gap: {{ section.settings.grid_gap | append: 'px'}};" data-id="{{ section.id }}" class="grid grid-cols-1 sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}">
        {%- liquid
          #Banner that is set to position 0
          assign section_blocks = section.blocks | map: 'settings'
          assign first_banner = section_blocks | where: 'nth_item', 0 | first
          unless first_banner == blank
            assign show_first_banner = true
            if first_banner.only_on_first_page and paginate.current_page > 1
              assign show_first_banner = false
            endif

            if show_first_banner == true
              render 'card-banner', current_block: first_banner, ipr_array: ipr_array
              assign items_to_preload = items_to_preload | minus: 1
            endif
          endunless

          for article in blog.articles
            assign blocks = section_blocks | where: 'nth_item', forloop.index
            assign current_block = blocks[0]
            assign only_on_first_page = current_block.only_on_first_page
            assign show_banner = true

            if only_on_first_page and paginate.current_page > 1
              assign show_banner = false
            endif

            assign preload = false
            if preload_media and forloop.index <= items_to_preload
              assign preload = true
            endif

            render 'card-article', article: article, sizes: sizes, preload: preload,

            if show_banner == true and current_block != blank
              render 'card-banner', current_block: current_block, ipr_array: ipr_array
              if forloop.index <= items_to_preload
                assign items_to_preload = items_to_preload | minus: 1
              endif
            endif
          endfor

          render 'loading'
        -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate, anchor: '' %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
  {
    "name": "t:sections.main-blog.name",
    "class": "section--main-blog",
    "tag": "section",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.main-blog.info"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "default",
        "label": "t:sections.colors.color_scheme.label"
      },
      {
        "type": "range",
        "id": "posts_per_page",
        "min": 1,
        "max": 50,
        "default": 16,
        "label": "t:sections.main-blog.settings.posts_per_page.label"
      },
      {
        "type": "checkbox",
        "id": "show_blog_title",
        "default": true,
        "label": "t:sections.main-blog.settings.show_blog_title.label"
      },
      {
        "type": "checkbox",
        "id": "enable_filtering",
        "default": true,
        "label": "t:sections.main-blog.settings.enable_filtering.label",
        "info": "t:sections.main-blog.settings.enable_filtering.info"
      },
      {
        "type": "checkbox",
        "id": "center_text",
        "label": "t:sections.main-blog.settings.center_text.label",
        "default": false
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "t:sections.main-blog.settings.grid_gap.label",
        "unit": "px",
        "min": 0,
        "max": 40,
        "default": 24
      },
      {
        "type": "header",
        "content": "t:sections.headers.desktop_layout"
      },
      {
        "type": "range",
        "id": "md_items_per_row",
        "min": 1,
        "max": 6,
        "default": 4,
        "label": "t:sections.main-blog.settings.articles_per_row.label"
      },
      {
        "type": "header",
        "content": "t:sections.headers.tablet_layout"
      },
      {
        "type": "range",
        "id": "sm_items_per_row",
        "min": 1,
        "max": 4,
        "default": 4,
        "label": "t:sections.main-blog.settings.articles_per_row.label"
      }
    ],
    "blocks": [
      {
        "type": "banner",
        "name": "t:sections.banners.label",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.images.bg_image",
            "info": "t:sections.images.bg_image__info"
          },
          {
            "type": "text",
            "id": "video_file_name",
            "label": "t:sections.images.bg_video",
            "info": "t:inputs.url.video_url__info"
          },
          {
            "type": "range",
            "id": "nth_item",
            "label": "t:sections.banners.visibility.nth_item",
            "min": 0,
            "max": 50,
            "default": 3,
            "info": "t:sections.banners.visibility.nth_item__info"
          },
          {
            "type": "checkbox",
            "id": "only_on_first_page",
            "label": "t:sections.banners.visibility.only_on_first_page",
            "info" : "t:sections.banners.visibility.only_on_first_page__info",
            "default": true
          },
          {
            "type": "url",
            "id": "url",
            "label": "t:inputs.url.link"
          },
          {
            "type": "header",
            "content": "t:sections.headers.overlay_content"
          },
          {
            "type": "inline_richtext",
            "id": "title",
            "label": "t:inputs.text.title"
          },
          {
            "type": "select",
            "id": "title_style",
            "label": "t:sections.typography.style_options.heading_style_label",
            "default": "h3",
            "options": [
              {
                "value": "h3",
                "label": "t:inputs.text.title",
                "group": "t:sections.typography.style_options.text_group"
              },
              {
                "value": "body-text",
                "label": "t:sections.typography.style_options.body_text",
                "group": "t:sections.typography.style_options.text_group"
              },
              {
                "value": "subheading",
                "label": "t:inputs.text.subtitle",
                "group": "t:sections.typography.style_options.text_group"
              },
              {
                "value": "btn",
                "label": "t:sections.typography.style_options.primary_button",
                "group": "t:sections.typography.style_options.button_group"
              },
              {
                "value": "btn btn--secondary",
                "label": "t:sections.typography.style_options.secondary_button",
                "group": "t:sections.typography.style_options.button_group"
              },
              {
                "value": "btn btn--link",
                "label": "t:sections.typography.style_options.link",
                "group": "t:sections.typography.style_options.button_group"
              }
            ]
          },
          {
            "type": "select",
            "id": "content_alignment",
            "label": "t:sections.layout.position.heading_label",
            "default": "vertical-bottom horizontal-left",
            "options": [
              {
                "value": "vertical-top horizontal-left",
                "label": "t:sections.layout.position.options.top_left"
              },
              {
                "value": "vertical-top horizontal-center",
                "label": "t:sections.layout.position.options.top_center"
              },
              {
                "value": "vertical-top horizontal-right",
                "label": "t:sections.layout.position.options.top_right"
              },
              {
                "value": "vertical-center horizontal-left",
                "label": "t:sections.layout.position.options.middle_left"
              },
              {
                "value": "vertical-center horizontal-center",
                "label": "t:sections.layout.position.options.middle_center"
              },
              {
                "value": "vertical-center horizontal-right",
                "label": "t:sections.layout.position.options.middle_right"
              },
              {
                "value": "vertical-bottom horizontal-left",
                "label": "t:sections.layout.position.options.bottom_left"
              },
              {
                "value": "vertical-bottom horizontal-center",
                "label": "t:sections.layout.position.options.bottom_center"
              },
              {
                "value": "vertical-bottom horizontal-right",
                "label": "t:sections.layout.position.options.bottom_right"
              }
            ]
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "t:sections.colors.heading_color",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "overlay_color",
            "label": "t:sections.colors.overlay_color",
            "default": "#000000"
          },
          {
            "type": "range",
            "id": "overlay_opacity",
            "label": "t:sections.colors.overlay_opacity",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%"
          },
          {
            "type": "header",
            "content": "t:sections.headers.desktop_layout"
          },
          {
            "type": "range",
            "id": "md_column_span",
            "label": "t:sections.banners.column_span.label",
            "min": 1,
            "max": 6,
            "default": 1,
            "info": "t:sections.banners.column_span.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.tablet_layout"
          },
          {
            "type": "range",
            "id": "sm_column_span",
            "label": "t:sections.banners.column_span.label",
            "min": 1,
            "max": 4,
            "default": 1,
            "info": "t:sections.banners.column_span.info"
          }
        ]
      },
      {
        "name": "t:blocks.custom_spacing.name",
        "type": "custom_spacing",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "t:blocks.custom_spacing.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.desktop_layout"
          },
          {
            "type": "range",
            "id": "sm_margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          },
          {
            "type": "header",
            "content": "t:sections.headers.mobile_layout"
          },
          {
            "type": "range",
            "id": "margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          }
        ]
      }
    ]
  }
{% endschema %}