          "type": "image_picker",
          "id": "image",
          "label": "t:inputs.image_picker.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:inputs.video.label"
        }
      ]
    },
    {
      "name": "t:blocks.custom_spacing.name",
      "type": "custom_spacing",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:blocks.custom_spacing.info"
        },
        {
          "type": "header",
