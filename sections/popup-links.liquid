        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:inputs.text.button_label",
          "default": "Button label"
        },
        {
          "type": "header",
          "content": "t:blocks.popup_content.name"
        },
        {
          "type": "paragraph",
          "content": "t:blocks.popup_content.info"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:inputs.text.text",
          "default": "<h3>Slide heading</h3><p>This text with the selected image or video will be shown in a popup when the Popup link is clicked. When image or video is used the pop up is divided to two columns in desktop, in mobile the media will be displayd on top.</p>"
