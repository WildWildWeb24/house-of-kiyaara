        {
          "type": "range",
          "id": "sm_padding_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "t:sections.layout.paddings.top",
          "default": 0
        },
        {
          "type": "range",
          "id": "sm_padding_bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "t:sections.layout.paddings.bottom",
          "default": 0
        },
        {
          "type": "header",
          "content": "t:sections.headers.mobile_layout"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "t:sections.layout.margin_top",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "t:sections.layout.paddings.top",
          "default": 0
