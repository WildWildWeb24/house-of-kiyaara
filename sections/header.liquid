{%- comment -%}
  Drawer styles are lazily loaded.
  Lazy load is based on Filament Group method: https://www.filamentgroup.com/lab/load-css-simpler/
  While it's a bit outdated, the method is still valid way of asynchronously loading styles.
  However as it relies on JavaScript to work, we have a <noscript> fallback..
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'component-drawers.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-accordions.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>
  {{ 'component-drawers.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordions.css' | asset_url | stylesheet_tag }}
  {{ 'component-search.css' | asset_url | stylesheet_tag }}
</noscript>

{%- liquid
  if settings.cart_button_function == 'drawer' and template != 'cart'
    assign drawer_cart_enabled = true
  else
    assign drawer_cart_enabled = false
  endif

  # MAIN MENU
  assign main_menu = linklists[section.settings.main_menu.handle]

  # LAYOUT SETTINGS
  assign header_layout = section.settings.header_layout | split: '__'
  assign logo_position = header_layout | first | split: '-' | last
  assign menu_position = header_layout | last | split: '-' | last

  # ICON SETTINGS
  assign action_buttons_type = section.settings.action_buttons_type
  assign search_enabled = settings.enable_search
  if shop.customer_accounts_enabled or shop.customer_accounts_optional
    assign accounts_enabled = true
  else
    assign accounts_enabled = false
  endif

  # MEGA MENU CONTENT TITLES
  if section.blocks.size > 0
    assign content_menu_titles = ''
    for block in section.blocks
      assign content_menu_titles = content_menu_titles | append: ',' | append: block.settings.menu_parent
    endfor
  endif
  assign content_menu_titles = content_menu_titles | remove_first: ',' | split: ',' | uniq

  # LOGO SETTINGS
  assign logo_object = section.blocks | where: 'type', 'logo' | first
  assign logo_image = logo_object.settings.logo_default

  # OVERLAY HEADER
  assign overlay_object = section.blocks | where: 'type', 'overlay' | first
  assign overlay_header = false
  assign inverted_colors = overlay_object.settings.inverted_colors
  assign overlay_templates = overlay_object.settings.overlay_templates | downcase | remove: ':inverted' | remove: ':default' | newline_to_br | strip_newlines | split: '<br />'
  assign overlay_templates_with_color_info = overlay_object.settings.overlay_templates | newline_to_br | strip_newlines | split: '<br />'
  assign disabled_templates = overlay_object.settings.disabled_templates | downcase | newline_to_br | strip_newlines | split: '<br />'
  assign overlay_handles = overlay_object.settings.overlay_handles | newline_to_br | strip_newlines | split: '<br />'
  assign alt_logo_image = overlay_object.settings.logo_with_background_color

  if template.name == 'index' and overlay_object.settings.overlay_index
    assign overlay_header = true
  elsif template.name == 'collection' and overlay_object.settings.overlay_collection
    assign overlay_header = true
  elsif template.name == 'product' and overlay_object.settings.overlay_product
    assign overlay_header = true
  endif

  if overlay_templates != blank or disabled_templates != blank
    if template.suffix
      assign full_template_name = template.name | append: '.' | append: template.suffix | downcase
    else
      assign full_template_name = template.name
    endif
  endif

  if overlay_templates != blank
    if overlay_templates contains full_template_name
      assign overlay_header = true
      assign full_template_name_inverted = full_template_name | append: ':inverted'
      if overlay_templates_with_color_info contains full_template_name_inverted
        assign inverted_colors = true
      else
        assign inverted_colors = false
      endif
    endif
  endif

  if disabled_templates != blank
    if disabled_templates contains full_template_name
      assign overlay_header = false
    endif
  endif

  if overlay_handles contains handle
    assign overlay_header = true
  endif

  if overlay_header and alt_logo_image and inverted_colors
    assign use_alt_logo_on_overlay = true
  else
    assign use_alt_logo_on_overlay = false
  endif
-%}

{%- capture logo_element -%}
  <a class="header-logo{% if use_alt_logo_on_overlay %} --alt-on-overlay{% endif %}" href="{{ routes.root_url }}">
    {% if logo_image %}
      {{ logo_image | image_url: width: 600 | image_tag: width: logo_image.width, height: logo_image.height, preload: true, alt: 'shop.name', class: 'site-logo --default' }}
      {% if use_alt_logo_on_overlay %}
      {{ alt_logo_image | image_url: width: 600 | image_tag: width: logo_image.width, height: logo_image.height, preload: true, alt: 'shop.name', class: 'site-logo --alt' }}
      {% endif %}
    {% else %}
      <h1 class="site-logo size--tiny --text pt-12 pb-12">{{ shop.name }}</h1>
    {% endif %}
  </a>
{%- endcapture -%}

{%- capture header_menu -%}
  {% render 'header-main-menu',
    main_menu: main_menu,
    content_menu_titles: content_menu_titles,
    desktop_submenu_type: section.settings.desktop_submenu_type,
    menu_position: menu_position
  %}
{%- endcapture -%}

{%- capture menu_button -%}
  <button type="button" aria-controls="drawer-menu" data-open="drawer-menu" class="action-button menu-button action-button--{{ action_buttons_type }}{% unless menu_position == 'drawer' %} md-hide{% endunless %}">
    <div class="action-button-label">{{ 'sections.header.menu' | t }}</div>
    <div class="action-button-icon">{% render 'icon-menu' %}</div>
  </button>
{%- endcapture -%}

{%- capture search_button -%}
  <button type="button" aria-controls="drawer-search" data-open="drawer-search" class="action-button search-button action-button--{{ action_buttons_type }}">
    <div class="action-button-label">{{ 'general.search.search' | t }}</div>
    <div class="action-button-icon">{% render 'icon-search' %}</div>
  </button>
{%- endcapture -%}

{%- capture account_button -%}
  <a href="{{ routes.account_url }}" class="action-button account-button action-button--{{ action_buttons_type }}">
    <div class="action-button-label">{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}</div>
    <div class="action-button-icon">{% render 'icon-account' %}</div>
    {% if customer %}
      <span class="account-blip" aria-hidden="true">&checkmark;</span>
    {% endif %}
  </a>
{%- endcapture -%}

{%- capture cart_button -%}
  {% if drawer_cart_enabled %}
  <button type="button" aria-controls="drawer-cart" data-open="drawer-cart" class="action-button cart-button action-button--{{ action_buttons_type }}{% if cart.item_count > 0 %} has-count-visible{% endif %}">
  {% else %}
  <a href="{{ routes.cart_url }}" class="action-button cart-button action-button--{{ action_buttons_type }}{% if cart.item_count > 0 %} has-count-visible{% endif %}">
  {% endif %}
    <div class="action-button-label">{{ 'templates.cart.cart' | t }}</div>
    <div class="action-button-icon">{% render 'icon-cart' %}</div>
    <span data-cart-count class="cart-blip" aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>
      {{- cart.item_count -}}
    </span>
  {% if drawer_cart_enabled %}
  </button>
  {% else %}
  </a>
  {% endif %}
{%- endcapture -%}

<style>
  :root {
    --logo-padding: {{ logo_object.settings.logo_padding | default: 6 | append: 'px' }} 12px;
    --sm-logo-padding: {{ logo_object.settings.logo_padding_desktop | default: 6 | append: 'px' }} 0px;
    {% if logo_image -%}
      --logo-width: {{ logo_object.settings.logo_max_width | append: 'px' }};
      --sm-logo-width: {{ logo_object.settings.logo_max_width_desktop | append: 'px' }};
    {%- endif %}
  }
</style>


<header id="MainHeader" class="header container {% if section.settings.enable_full_width %} edge-to-edge{% else %}sm-down-edge-to-edge{% endif %} color-{{ section.settings.color_scheme }} {{ section.settings.header_layout }}{% if overlay_header %} overlay{% endif %} header-border--{{ section.settings.header_border_style }} {% if inverted_colors %}use-background{% else %}use-foreground{% endif %}" data-sticky-behavior="{{- section.settings.header_sticky_behavior -}}" style="--overlay-background-opacity: {{ overlay_object.settings.background_opacity | divided_by: 100.0 | default: 1 }}; --overlay-blur: {{ overlay_object.settings.background_blur |  default: 0 }}px">

  {% render 'toolbar' %}

  <div class="header-content">
    <div class="header-item --left" {% if logo_position == 'left' and menu_position == 'left' %}style="gap: 24px"{% endif %}>

      {%- if logo_position == 'center' -%}
        {{ menu_button }}

        {%- if search_enabled and menu_position == 'left' -%}
          {{ search_button |  replace: 'search-button', 'search-button md-hide'  }}
        {% elsif search_enabled and menu_position == 'below' or menu_position == 'drawer' %}
          {{ search_button  }}
        {%- endif -%}
      {%- endif -%}

      {%- if logo_position == 'left' -%}
        {{ logo_element }}
      {%- endif -%}

      {%- if menu_position == 'left' -%}
        {{ header_menu }}
      {%- endif -%}
    </div>

    {%- if logo_position == 'center' or menu_position == 'center' -%}
      <div class="header-item --center {% if logo_position == 'center' and menu_position == 'below' %}vertical{% endif %}">
        {%- if logo_position == 'center' -%}
          {{ logo_element }}
        {%- endif -%}

        {%- if menu_position == 'center' or menu_position == 'below' -%}
          {{ header_menu }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="header-item --right">
      {%- if logo_position == 'left' -%}
        {{ menu_button }}
      {%- endif -%}

      {%- if search_enabled -%}
        {%- if logo_position == 'left'-%}
          {{ search_button }}
        {%- elsif menu_position == 'left' -%}
          {{ search_button |  replace: 'search-button', 'search-button md-down-hide'  }}
        {%- endif -%}
      {%- endif -%}

      {%- if accounts_enabled -%}
        {{ account_button }}
      {%- endif -%}

      {{ cart_button }}
    </div>
  </div>
</header>

{%- liquid
  render 'drawer-menu', content_menu_titles: content_menu_titles, footer_info: section.settings.drawer_menu_footer_info
  render 'drawer-search'
  if drawer_cart_enabled
    render 'drawer-cart'
  endif
-%}

{% capture same_as_json_string %}
  {{- settings.social_twitter_link | json | append: ',' -}}
  {{- settings.social_facebook_link | json | append: ',' -}}
  {{- settings.social_pinterest_link | json | append: ',' -}}
  {{- settings.social_instagram_link | json | append: ',' -}}
  {{- settings.social_linkedin_link | json | append: ',' -}}
  {{- settings.social_tiktok_link | json | append: ',' -}}
  {{- settings.social_tumblr_link | json | append: ',' -}}
  {{- settings.social_twitch_link | json | append: ',' -}}
  {{- settings.social_untappd_link | json | append: ',' -}}
  {{- settings.social_snapchat_link | json | append: ',' -}}
  {{- settings.social_youtube_link | json | append: ',' -}}
  {{- settings.social_vimeo_link | json -}}
{% endcapture %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if logo_image -%}
      "logo": {{ logo_image | image_url: width: 500 | prepend: "https:" | json }},
    {% endif -%}
    "sameAs": [{{ same_as_json_string | remove: '"",' | strip }}],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.header.name",
    "class": "section--header site-header ignore-section-animation",
    "tag": "section",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.header.info"
      },
      {
        "id": "main_menu",
        "type": "link_list",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "default",
        "label": "t:sections.header.settings.color_schemes.header"
      },
      {
        "type": "select",
        "id": "header_layout",
        "label": "t:sections.header.settings.header_layout.label",
        "options": [
          {
            "label": "t:sections.header.settings.header_layout.options.logo_left_menu_left",
            "value": "logo-left__menu-left"
          },
          {
            "label": "t:sections.header.settings.header_layout.options.logo_left_menu_center",
            "value": "logo-left__menu-center"
          },
          {
            "label": "t:sections.header.settings.header_layout.options.logo_left_menu_drawer",
            "value": "logo-left__menu-drawer"
          },
          {
            "label": "t:sections.header.settings.header_layout.options.logo_center_menu_left",
            "value": "logo-center__menu-left"
          },
          {
            "label":  "t:sections.header.settings.header_layout.options.logo_center_menu_below",
            "value": "logo-center__menu-below"
          },
          {
            "label":  "t:sections.header.settings.header_layout.options.logo_center_menu_drawer",
            "value": "logo-center__menu-drawer"
          }
        ],
        "default": "logo-center__menu-left"
      },
      {
        "id": "desktop_submenu_type",
        "type": "select",
        "label": "t:sections.header.settings.desktop_submenu_type.label",
