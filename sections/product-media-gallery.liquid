    {
      "type": "select",
      "id": "variant_images",
      "label": "t:sections.product-media-gallery.settings.variant_images.label",
      "info": "t:sections.product-media-gallery.settings.variant_images.info",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "t:sections.product-media-gallery.settings.variant_images.options.all"
