{%- liquid
  # Blocks to variables
  assign header_block = section.blocks | where: 'type', 'section_header' | first
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first

  # Zoom settings
  assign zoom_type_mobile = section.settings.media_zoom
  assign zoom_type_desktop = section.settings.sm_media_zoom

  # IPR and Slider settings
  assign ipr_desktop = section.settings.items_per_row_desktop
  assign ipr_tablet = section.settings.items_per_row_tablet
  assign ipr_mobile = section.settings.items_per_row_mobile
  assign slider_mobile = false
  assign slider_desktop = false
  assign slide_peek = false
  assign full_width = section.settings.enable_full_width

  # Slider booleans
  if section.settings.layout_mobile contains 'slide'
    assign slider_mobile = true
  endif
  if section.settings.layout_desktop == 'slide'
    assign slider_desktop = true
  endif
  if section.settings.layout_mobile contains 'peek'
    assign slide_peek = true
  endif

  capture sizes
    render 'img_sizes', full_width: full_width, ipr_mobile: ipr_mobile, ipr_tablet: ipr_tablet, ipr_desktop: ipr_desktop
  endcapture

  # Media background color
  if section.settings.media_bg == 'transparent'
    assign media_background_color = 'transparent'
  else
    assign media_background_color = 'var(--color-card-background)'
  endif

  # Variant image logic variables
  # We are using src values to mach detect variant images inside the media loop (since media.id and image.id aren't the same).
  assign shown_items_count = 0
  assign variant_image_srcs = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign current_featured_image_src = product.selected_or_first_available_variant.featured_image.src
  assign found_match = false
  assign zoom_skip_positions = ''
-%}

{% unless product.media.size <= 1 %}
  <div
    id="ProductMediaGallery-{{ section.id }}"
    data-product-media-gallery
    data-section="{{ section.id }}"
    class="container section-spacing custom-child-for-animation color-{{ section.settings.color_scheme }}"
    {% if custom_spacing -%}
      style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
    {%- endif %}
  >
    {%- if header_block != blank -%}
      {% render 'section-header',
        size_multiplier: header_block.settings.size_multiplier,
        sm_size_multiplier: header_block.settings.sm_size_multiplier,
        text_align: header_block.settings.text_alignment,
        subtitle: header_block.settings.subtitle,
        subtitle_tag: header_block.settings.subtitle_tag,
        title: header_block.settings.title,
        title_tag: header_block.settings.title_tag,
        text: header_block.settings.text,
        shopify_attr: header_block.shopify_attributes
      %}
    {%- endif -%}

    <gridy-slider
      id="slider-{{ section.id }}"
      class="gridy-slider show-overflow-items product-media-slider"
      data-mobile-enabled="{{ slider_mobile }}"
      data-tablet-enabled="{{ slider_desktop }}"
      data-desktop-enabled="{{ slider_desktop }}"
      data-ipr-mobile="{{ ipr_mobile }}"
      data-ipr-tablet="{{ ipr_tablet }}"
      data-ipr-desktop="{{ ipr_desktop }}"
      data-arrows="true"
      data-progress-bar="true"
      data-overflow-visible="true"
    >
      <div
        class="grid sm-gap gridy-track scrollbar--hide grid-cols-{{ ipr_mobile }} sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}{% if slider_mobile %} track-inner-padding{% endif %}{% if slide_peek %} slide-peek{% endif %}"
        style="
          --gap: {{ settings.grid_gap | append: 'px' }};
          --sm-gap: {{ settings.grid_gap_sm | append: 'px' }};
        "
      >
        {% for media in product.media %}
          {% liquid
            if variant_image_srcs.size > 0
              unless product.has_only_default_variant
                # Variant images - IF Selected
                if section.settings.variant_images == 'selected' and variant_image_srcs contains media.src and current_featured_image_src != media.src
                  assign zoom_skip_positions = zoom_skip_positions | append: ',' | append: media.position
                  continue
                  # Variant images - Selected Group
                elsif section.settings.variant_images == 'selected_group'
                  if media.src contains current_featured_image_src
                    assign found_match = true
                  elsif found_match == false
                    assign zoom_skip_positions = zoom_skip_positions | append: ',' | append: media.position
                    continue
                  elsif variant_image_srcs contains media.src
                    assign zoom_skip_positions = zoom_skip_positions | append: ',' | append: media.position | append: '!'
                    break
                  endif
                endif
              endunless
            endif
          %}

          <div
            id="item-{{ media.id }}"
            class="product-media product-media--gallery-thumbnail {% if settings.enable_br_on_images %} br-img{% endif %}"
          >
            {% assign thumbnail_icon = 'none' %}
            {% if media.media_type == 'model' %}
              {% assign thumbnail_icon = 'model' %}
            {% elsif media.media_type == 'video' or media.media_type == 'external_video' %}
              {% assign thumbnail_icon = 'video' %}
            {% endif %}

            <modal-drawer-button>
              <button
                type="button"
                data-open="modal--zoom-gallery-big-image-gallery?scroll=modal-item-{{ media.id }}"
                class="product-media-zoom-link"
                aria-label="{{ 'accessibility.view_gallery_item' | t: item: forloop.index, total: product.media.size }}"
                aria-haspopup="dialog"
              >
                {% case thumbnail_icon %}
                  {% when 'video' %}
                    {% render 'icon-play' %}
                  {% when 'model' %}
                    {% render 'icon-3d-model' %}
                {% endcase %}
              </button>
            </modal-drawer-button>
            {%- render 'picture',
              image_default: media.preview_image,
              aspect_ratio: section.settings.media_aspect_ratio,
              sizing_rule: 'cover',
              background_color: media_background_color,
              sizes: sizes,
              preload: false
            -%}
          </div>
          {% assign shown_items_count = shown_items_count | plus: 1 %}
        {% endfor %}
      </div>

      {%- liquid
        assign arrows_hide_class = ''
        if shown_items_count <= ipr_desktop
          assign arrows_hide_class = arrows_hide_class | append: ' md-hide'
        endif
        if shown_items_count <= ipr_tablet
          assign arrows_hide_class = arrows_hide_class | append: ' sm-to-md-hide'
        endif
        if shown_items_count <= ipr_mobile
          assign arrows_hide_class = arrows_hide_class | append: ' sm-down-hide'
        endif

        render 'gridy-arrows-and-progress', class: arrows_hide_class, ipr_desktop: ipr_desktop, ipr_tablet: ipr_tablet, ipr_mobile: ipr_mobile, items_count: shown_items_count
      -%}
    </gridy-slider>
  </div>

  {% assign zoom_skip_positions = zoom_skip_positions | remove_first: ',' | split: ',' %}

  {% render 'modal-zoom-gallery',
    zoom_type_mobile: zoom_type_mobile,
    zoom_type_desktop: zoom_type_desktop,
    id: 'big-image-gallery',
    medias: product.media,
    zoom_skip_positions: zoom_skip_positions,
    skipped_total: shown_items_count
  %}
{% endunless %}

{% schema %}
