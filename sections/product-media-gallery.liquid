    },
    {
      "type": "range",
      "id": "items_per_row_tablet",
      "label": "t:sections.layout.items_per_row",
      "min": 2,
      "max": 8,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.headers.mobile_layout"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "t:sections.layout.display_type.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.layout.display_type.grid"
        },
        {
