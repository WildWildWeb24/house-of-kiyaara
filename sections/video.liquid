{% liquid
  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign media_block = section.blocks | where: "type", "video" | first

  # Defaults to media_top
  assign media_col_classes = 'col-12'
  assign content_col_classes = 'col-12 col-sm-10 col-sm-offset-2 col-md-8 col-md-offset-3'

  case section.settings.sm_media_position
    when 'media_left'
      assign media_col_classes = 'col-12 col-sm-6'
      assign content_col_classes = 'col-12 col-sm-6 col-md-4 col-md-offset-8'
    when 'media_right'
      assign media_col_classes = 'col-12 col-sm-6 col-md-offset-7 col-sm-order-2'
      assign content_col_classes = 'col-12 col-sm-6 col-md-4 col-md-offset-2'
  endcase
%}

<div
  id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div class="media-with-text grid col-align-items-center col-justify-items-center">
    <div class="{{ media_col_classes }}" {{ media_block.shopify_attributes }}>
      {% if media_block.settings.video != blank %}
        {{ media_block.settings.video | video_tag: controls: true, image_size: 'x1080', controlslist: 'nodownload', class: 'br-video' }}
      {% elsif media_block.settings.video_url != blank %}
        {% render 'video-url-to-player', video_url: media_block.settings.video_url %}
      {% else %}
        <video controls="controls" controlslist="nodownload" class="br-video" preload="metadata" poster="{{ 'placeholder_video.png' | asset_img_url: 'x1080' }}">
          <source src="{{ 'placeholder_video.mp4' | asset_url }}" type="video/mp4">
          <img src="{{ 'placeholder_video.png' | asset_img_url: 'x1080' }}" width="1920" height="1080">
        </video>
      {% endif %}
    </div>

    <div class="{{ content_col_classes }} pb-24 sm-pb-24 text-align-{{ section.settings.text_alignment }} sm-text-align-{{ section.settings.sm_text_alignment }}">
      {% render 'content-blocks',
        use_container: true,
        color_scheme: section.settings.color_scheme %}
    </div>
  </div>
</div>

