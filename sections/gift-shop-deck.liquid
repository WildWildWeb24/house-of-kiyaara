{{ 'page-gift-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign total_cards = section.blocks.size
  assign total_padded = total_cards
  if total_cards < 10
    assign total_padded = '0' | append: total_cards
  endif
-%}

{% render 'section-custom-colors', section: section %}
<div
  id="{{ section.id }}"
  class="gift-shop-deck-section color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sm-pt: {{ section.settings.md_padding_top }}px; --sm-pb: {{ section.settings.md_padding_bottom }}px; --deck-duration: {{ section.settings.autoplay_speed | default: 4 }}s;"
  data-gift-deck-section="{{ section.id }}"
  data-autoplay="{{ section.settings.enable_autoplay | default: true }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 4 }}">
  <div class="container">
    <div class="gift-deck__grid">
      {%- comment -%} Left on Desktop / Top on Mobile: 1:1 Stacked Card Deck {%- endcomment -%}
      <div class="gift-deck__visual-col">
        <div class="gift-deck__stage" data-gift-deck-stage>
          {%- for block in section.blocks -%}
            {%- liquid
              assign index_num = forloop.index
              if index_num < 10
                assign index_padded = '0' | append: index_num
              else
                assign index_padded = index_num
              endif
              assign stack_pos = forloop.index0
            -%}
            <div
              class="gift-deck__card{% if forloop.first %} is-active{% endif %}"
              data-gift-deck-card="{{ forloop.index0 }}"
              data-stack-pos="{{ stack_pos }}"
              {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="gift-deck__card-media">
                  {{
                    block.settings.image
                    | image_url: width: 1080
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1080',
                      sizes: '(max-width: 767px) 85vw, 480px',
                      class: 'gift-deck__card-img'
                  }}
                </div>
              {%- else -%}
                <div class="gift-deck__card-placeholder"></div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Right on Desktop / Bottom on Mobile: Heading + Interactive List + CTA {%- endcomment -%}
      <div class="gift-deck__content-col">
        {%- if section.settings.title != blank -%}
          <div class="gift-deck__header">
            <h2 class="gift-deck__title {{ section.settings.heading_size }}">
              {{ section.settings.title | replace: '[br]', '<br/>' }}
            </h2>
          </div>
        {%- endif -%}

        <div class="gift-deck__list" role="tablist" aria-label="{{ section.settings.title | strip_html | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              class="gift-deck__item{% if forloop.first %} is-active{% endif %}"
              data-gift-deck-trigger="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}>
              <span class="gift-deck__item-body">
                <span class="gift-deck__item-title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="gift-deck__item-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </span>
            </button>
          {%- endfor -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <div class="gift-deck__cta-wrap">
            <a href="{{ section.settings.button_link | default: '#shopify-section-collection_switcher_gift_curated' }}" class="gift-deck__cta-link">
              <span>{{ section.settings.button_label | escape }}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M6 1.5V10.5M6 10.5L2.25 6.75M6 10.5L9.75 6.75" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initGiftDeck(sectionEl) {
      if (!sectionEl) return;
      var triggers = Array.prototype.slice.call(sectionEl.querySelectorAll('[data-gift-deck-trigger]'));
      var cards = Array.prototype.slice.call(sectionEl.querySelectorAll('[data-gift-deck-card]'));
      var listEl = sectionEl.querySelector('.gift-deck__list');
      var stageEl = sectionEl.querySelector('[data-gift-deck-stage]');
      var total = cards.length;
      if (!total) return;

      var activeIndex = 0;
      var autoplayEnabled = sectionEl.getAttribute('data-autoplay') !== 'false' && total > 1;
      var autoplaySpeedMs = (parseInt(sectionEl.getAttribute('data-autoplay-speed'), 10) || 4) * 1000;
      var autoplayTimer = null;
      var resumeTimeout = null;

      function setActive(nextIndex) {
        activeIndex = (nextIndex + total) % total;

        triggers.forEach(function(btn, idx) {
          var isActive = idx === activeIndex;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        cards.forEach(function(card, idx) {
          var isActive = idx === activeIndex;
          var relativePos = (idx - activeIndex + total) % total;
          card.classList.toggle('is-active', isActive);
          card.setAttribute('data-stack-pos', String(relativePos));
        });
      }

      function startAutoplay() {
        if (!autoplayEnabled) return;
        stopAutoplay();
        autoplayTimer = setInterval(function() {
          setActive((activeIndex + 1) % total);
        }, autoplaySpeedMs);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function pauseAutoplay(temporaryMs) {
        if (!autoplayEnabled) return;
        stopAutoplay();
        if (resumeTimeout) {
          clearTimeout(resumeTimeout);
          resumeTimeout = null;
        }
        if (temporaryMs) {
          resumeTimeout = setTimeout(function() {
            startAutoplay();
          }, temporaryMs);
        }
      }

      function resumeAutoplay() {
        if (!autoplayEnabled) return;
        if (resumeTimeout) {
          clearTimeout(resumeTimeout);
          resumeTimeout = null;
        }
        startAutoplay();
      }

      triggers.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var idx = parseInt(btn.getAttribute('data-gift-deck-trigger'), 10);
          if (!isNaN(idx)) {
            setActive(idx);
            pauseAutoplay(5000);
          }
        });

        btn.addEventListener('mouseenter', function() {
          if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            var idx = parseInt(btn.getAttribute('data-gift-deck-trigger'), 10);
            if (!isNaN(idx) && idx !== activeIndex) {
              setActive(idx);
            }
            pauseAutoplay();
          }
        });
      });

      if (listEl) {
        listEl.addEventListener('mouseenter', function() {
          if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            pauseAutoplay();
          }
        });
        listEl.addEventListener('mouseleave', function() {
          if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            resumeAutoplay();
          }
        });
      }

      if (stageEl) {
        stageEl.addEventListener('mouseenter', function() {
          if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            pauseAutoplay();
          }
        });
        stageEl.addEventListener('mouseleave', function() {
          if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            resumeAutoplay();
          }
        });
      }

      cards.forEach(function(card) {
        card.addEventListener('click', function() {
          var idx = parseInt(card.getAttribute('data-gift-deck-card'), 10);
          var pos = parseInt(card.getAttribute('data-stack-pos'), 10);
          if (pos === 0 && total > 1) {
            setActive((idx + 1) % total);
          } else if (!isNaN(idx)) {
            setActive(idx);
          }
          pauseAutoplay(5000);
        });
      });

      sectionEl.addEventListener('shopify:block:select', function(event) {
        var target = event.target;
        var idxAttr = target.getAttribute('data-gift-deck-trigger') || target.getAttribute('data-gift-deck-card');
        if (idxAttr !== null) {
          var idx = parseInt(idxAttr, 10);
          if (!isNaN(idx)) {
            setActive(idx);
            pauseAutoplay();
          }
        }
      });

      sectionEl.addEventListener('shopify:block:deselect', function() {
        resumeAutoplay();
      });

      startAutoplay();
    }

    var sectionEl = document.querySelector('[data-gift-deck-section="{{ section.id }}"]');
    initGiftDeck(sectionEl);

    document.addEventListener('shopify:section:load', function(event) {
      var loaded = event.target.querySelector('[data-gift-deck-section]');
      if (loaded) initGiftDeck(loaded);
    });

    document.addEventListener('click', function(event) {
      var link = event.target.closest('a[href^="#shopify-section-"]');
      if (!link) return;
      var suffix = link.getAttribute('href').replace('#shopify-section-', '');
      if (!suffix) return;
      var target = document.getElementById('shopify-section-' + suffix) || document.querySelector('[id^="shopify-section-"][id$="' + suffix + '"]');
      if (target) {
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Gift shop feature deck",
  "tag": "section",
  "class": "section-gift-shop-deck",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Why a Kiyaara gift feels different"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "EXPLORE OUR BUNDLES"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Auto-cycle through points",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Seconds per point",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 112
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 112
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 64
    },
    {
      "type": "header",
      "content": "Custom colors & borders"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "custom_card_bg_color",
      "label": "Card / box background color"
    },
    {
      "type": "color",
      "id": "custom_border_color",
      "label": "Section border color"
    },
    {
      "type": "color",
      "id": "custom_card_border_color",
      "label": "Card / badge border color"
    },
    {
      "type": "range",
      "id": "custom_border_width",
      "label": "Border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "custom_accent_color",
      "label": "Accent color (subtitles, badges, icons)"
    },
    {
      "type": "color",
      "id": "custom_heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "custom_btn_bg_color",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "custom_btn_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "custom_btn_border_color",
      "label": "Button border color"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Art-led"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Description",
          "default": "Every design begins as original hand-painted artwork, so no two collections look like anyone else's. There's art on the bag linings, too."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image (1:1 square recommended)"
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "Placeholder label (shown when no image)",
          "default": "[ ART-LED PACKAGING ]"
        },
        {
          "type": "text",
          "id": "card_caption",
          "label": "Card overlay quote",
          "default": "\"Every design begins as original hand-painted artwork.\""
        },
        {
          "type": "checkbox",
          "id": "show_card_overlay",
          "label": "Show counter & quote overlay on image",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift shop feature deck",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Art-led",
