            "text": "Vegan leather, cruelty free, and made for someone who cares about that too.",
            "placeholder_label": "[ VEGAN LEATHER CRAFTSMANSHIP ]",
            "card_caption": "\"Vegan leather, cruelty free, and made with care.\""
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Made to be personal",
            "text": "Add custom note cards, packaging and personalised inserts so every gift carries your message.",
            "placeholder_label": "[ CUSTOM NOTE CARDS & INSERTS ]",
            "card_caption": "\"Every gift carries your personal message.\""
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Wrapped in joy",
