            "placeholder_label": "[ SIGNATURE WRAPPED BOX ]",
            "card_caption": "\"Wearable art inside waiting to be discovered.\""
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Gifting made easy",
            "text": "A dedicated gifting team, smooth coordination and reliable delivery across India, whether you're gifting ten people or a hundred.",
            "placeholder_label": "[ PAN-INDIA GIFTING CONCIERGE ]",
            "card_caption": "\"Smooth coordination and reliable delivery across India.\""
          }
        }
      ]
    }
  ]
}
{% endschema %}
