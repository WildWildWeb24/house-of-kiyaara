{% liquid
  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign background_block = section.blocks | where: 'type', 'background' | first

  # Size and offset class logic
  case section.settings.content_width
    when 'full'
      assign col_class = 'col-md-12'
    when 'wide'
      assign col_class = 'col-md-10'
      if section.settings.sm_content_position == 'center'
        assign col_class = col_class | append: ' col-md-offset-2'
      elsif section.settings.sm_content_position == 'right'
        assign col_class = col_class | append: ' col-md-offset-3'
      endif
    when 'default'
      assign col_class = 'col-sm-10 col-md-8 col-lg-6'
      if section.settings.sm_content_position == 'center'
        assign col_class = col_class | append: ' col-sm-offset-2 col-md-offset-3 col-lg-offset-4'
      elsif section.settings.sm_content_position == 'right'
        assign col_class = col_class | append: ' col-sm-offset-3 col-md-offset-5 col-lg-offset-6'
      endif
    when 'narrow'
      assign col_class = 'col-sm-8 col-md-6 col-lg-4'
      if section.settings.sm_content_position == 'center'
        assign col_class = col_class | append: ' col-sm-offset-3 col-md-offset-4 col-lg-offset-5'
      elsif section.settings.sm_content_position == 'right'
        assign col_class = col_class | append: ' col-sm-offset-5 col-md-offset-7 col-lg-offset-8'
      endif
  endcase
%}

<div
  id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>

  {% if background_block %}
    {% render 'block--section-background', block: background_block %}
  {% endif %}

  <div class="grid text-align-{{ section.settings.text_alignment }} sm-text-align-{{ section.settings.sm_text_alignment }}" style="justify-content: {{ section.settings.sm_content_position }};">
    <div class="col-12 content-blocks {{ col_class }}">
      {% render 'content-blocks',
        use_container: false,
        color_scheme: section.settings.color_scheme %}
    </div>
  </div>
</div>

