{% liquid
  if settings.currency_code_enabled
    assign initial_value = gift_card.initial_value | money_with_currency
    assign gift_card_balance = gift_card.balance | money_with_currency
  else
    assign initial_value = gift_card.initial_value | money
    assign gift_card_balance = gift_card.balance | money
  endif

  assign card_bg = section.settings.color_card_background | default: '#181513'
  assign card_bg_with_transparency = card_bg | append: '88'
  assign card_bg_transparent = card_bg | append: '00'

  assign card_logo = section.settings.logo
  if card_logo == blank
    if images['logo-footer4X.png'] != blank
      assign card_logo = images['logo-footer4X.png']
    elsif images['kiyaara-logo-about-farasha.png'] != blank
      assign card_logo = images['kiyaara-logo-about-farasha.png']
    endif
  endif

  assign card_bg_image = section.settings.card_background_image
  assign card_bg_preset = section.settings.card_bg_preset | default: 'kiyaara-giftcard-01-1.png'
  assign has_bg_media = false
  if card_bg_image != blank or card_bg_preset != 'none'
    assign has_bg_media = true
  endif

  assign logo_max_width = section.settings.logo_max_width | default: 140
  assign logo_style = section.settings.logo_style | default: 'white'
  assign overlay_color = section.settings.card_overlay_color | default: '#181513'
  assign overlay_opacity = section.settings.card_overlay_opacity | default: 35 | divided_by: 100.0
  assign card_subtitle = section.settings.card_subtitle
  if card_subtitle == blank
    assign card_subtitle = 'gift_cards.title' | t
  endif
%}

<div class="gift-card-container color-{{ section.settings.color_scheme }}">
  {% if section.settings.show_section_background -%}
    {% render 'block--section-background' %}
  {%- endif %}

  <div
    class="gift-card{% if has_bg_media %} has-bg-image{% endif %}"
    style="
      --card-bg: {{ card_bg }};
      --card-bg-with-transparency: {{ card_bg_with_transparency }};
      --card-bg-transparent: {{ card_bg_transparent }};
      --card-color: {{ section.settings.color_card_foreground | default: '#ffffff' }};
      --card-logo-width: {{ logo_max_width }}px;
      --card-overlay-color: {{ overlay_color }};
      --card-overlay-opacity: {{ overlay_opacity }};
    ">
    {% if has_bg_media %}
      <div class="gift-card__media" aria-hidden="true">
        {% if card_bg_image != blank %}
          {{
            card_bg_image
            | image_url: width: 1400
            | image_tag:
              widths: '600, 900, 1200, 1400',
              sizes: '(max-width: 767px) 92vw, 660px',
              preload: true,
              alt: '',
              class: 'gift-card__bg-image'
          }}
        {% else %}
          <img
            src="{{ card_bg_preset | asset_url }}"
            width="1400"
            height="800"
            alt=""
            class="gift-card__bg-image">
        {% endif %}
        <span class="gift-card__overlay"></span>
      </div>
    {% endif %}

    <div class="git-card-header gift-card-header">
      {% if card_logo != blank %}
        {{
          card_logo
          | image_url: width: 600
          | image_tag:
            width: 300,
            preload: true,
            alt: shop.name,
            class: 'logo logo--' | append: logo_style
        }}
      {% else %}
        <img
          src="{{ 'kiyaara-logo-giftcard.png' | asset_url }}"
          width="300"
          height="218"
          alt="{{ shop.name | escape }}"
          class="logo logo--{{ logo_style }}">
      {% endif %}
      <h5 class="gift-card-subheadin gift-card-subheading subheading">{{ card_subtitle }}</h5>
    </div>

    <div class="gift-card-balance-info sm-text-align-right">
      <p class="h2 size--large gift-card-initial-amount">{{- initial_value -}}</p>
      {% if gift_card.balance != gift_card.initial_value -%}
        <p class="h5 subheading gift-card-remaining">{{ 'gift_cards.remaining_html' | t: balance: gift_card_balance }}</p>
      {%- endif %}
    </div>

    <div class="gift-card-code">
      <span class="gift-card-code__label">Gift Card Code</span>
      <p class="h4 size--large subheading gift-card-code__value">{{ gift_card.code | format_code }}</p>
    </div>

    <div class="gift-card-qr-code">
      <div id="QRCode" class="the-qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
    </div>
  </div>

  <div class="gift-card-info-and-actions text-align-center">
    {% if gift_card.enabled == false or gift_card.expired -%}
      <p class="gift-card-info expired mt-24 mb-24 sm-mt-32 sm-mb-32" style="color: var(--error);">{{ 'gift_cards.expired_info' | t }}</p>
    {% else %}
      <p class="gift-card-info mt-24 mb-24 sm-mt-32 sm-mb-32">{{ 'gift_cards.info' | t }}</p>
    {% endif %}

    <div class="gift-cards-actions">
      <button class="btn btn--primary btn--full sm-size--large" id="copyCodeButton" data-code="{{ gift_card.code | format_code }}">{{ 'gift_cards.copy_code' | t }}<span aria-hidden="true" class="button-success-message">{{ 'gift_cards.copy_code_success' | t }}</span></button>
      <a href="{{ shop.url }}" class="btn btn--secondary btn--full sm-size--large" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
        {{- 'gift_cards.shop_link' | t -}}
      </a>
    </div>
    {% if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="gift-card-apple-wallet mt-12 sm-mt-32">
        <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.add_to_apple_wallet' | t }}" loading="lazy">
      </a>
    {%- endif %}
  </div>
</div>

<script>
  console.log("Gift Card init");
  const string = { qrImageAlt: {{ 'gift_cards.qr_image_alt' | t | json }} };
  document.addEventListener('DOMContentLoaded', function() {
    new QRCode(document.getElementById('QRCode'), {
      text: document.getElementById('QRCode').dataset.identifier,
      width: 220,
      height: 220,
      imageAltText: string.qrImageAlt
    });

    setTimeout(function() {
      document.getElementById('QRCode').classList.add('loaded');
    }, 500);
  });

  const copyButton = document.getElementById("copyCodeButton");

  copyButton.addEventListener("click", (e) => {
    console.log("Copy Button init");
    const codeToCopy = copyButton.getAttribute("data-code");
    const successMessage = copyButton.querySelector(".copy-success");

    navigator.clipboard.writeText(codeToCopy).then(() => {
        // Show success message
        copyButton.classList.add("show-success-message");

        // Hide message after 2 seconds
        setTimeout(() => {
          copyButton.classList.remove("show-success-message");
        }, 2000);
    }).catch(err => {
        console.error("Failed to copy text: ", err);
    });
  });
</script>

{% schema %}
{
  "name": "Gift card",
  "class": "section--featured-product main-product featured-product anim-custom-child",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Brand & Text"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.blocks.logo.image.label",
      "info": "t:sections.header.blocks.logo.image.info"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 70,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Gift card text",
      "default": "Gift card"
    },
    {
      "type": "header",
      "content": "Card background image"
    },
    {
      "type": "image_picker",
      "id": "card_background_image",
      "label": "Custom card background image",
      "info": "Upload a custom image, or leave empty to use the Kiyaara artwork preset below."
    },
    {
      "type": "select",
      "id": "card_bg_preset",
      "label": "Kiyaara gift card artwork preset",
      "default": "kiyaara-giftcard-01-1.png",
      "options": [
        {
          "value": "kiyaara-giftcard-01-1.png",
          "label": "1 — Deep Teal Monogram & Butterfly"
        },
        {
          "value": "kiyaara-giftcard-01-2.png",
          "label": "2 — Forest Green Moth & Floral"
        },
        {
          "value": "kiyaara-giftcard-01.png",
          "label": "3 — Cream Butterfly Garden"
        },
        {
          "value": "kiyaara-giftcard-01-3.png",
          "label": "4 — Sky Blue Gingham & Moth"
        },
        {
          "value": "none",
          "label": "None (Solid Card Color)"
        }
      ]
    },
    {
      "type": "color",
      "id": "card_overlay_color",
      "label": "Card image overlay color",
      "default": "#181513"
    },
    {
      "type": "range",
      "id": "card_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Card image overlay opacity",
      "default": 35
    },
    {
      "type": "header",
      "content": "Section & card colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "t:sections.colors.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "show_section_background",
      "label": "Show section background",
      "default": true
    },
    {
      "type": "color",
      "id": "color_card_foreground",
      "label": "Card Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_card_background",
      "label": "Card Background",
      "default": "#181513"
    }
  ]
}
{% endschema %}