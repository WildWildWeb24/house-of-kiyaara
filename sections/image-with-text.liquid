{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign media_block = section.blocks | where: 'type', 'image' | first
  assign background_block = section.blocks | where: 'type', 'background' | first
  assign single_button_width_classes = ''
  assign sizes_string = '(max-width: 767px) 100vw, (max-width: 1023px) calc(100vw / 2 ), calc(' | append: settings.content_ideal_width | append: 'px / ( 12 / ' | append: section.settings.media_width | append: '))' | strip

  # Button width classes
  if section.settings.sm_full_width_buttons
    assign single_button_width_classes = 'sm-btn--full'
  endif

  if section.settings.full_width_buttons
    assign single_button_width_classes = single_button_width_classes | append: ' sm-down-btn--full' | strip
  endif

  # Text column width
  assign md_text_col_width = 12 | minus: section.settings.media_width

  assign render_section = true
  if template.name == 'product' and media_block != blank
    if media_block.settings.media_toggle == 'show_video' and media_block.settings.video == blank
      unless request.design_mode
        assign render_section = false
      endunless
    elsif media_block.settings.media_toggle == 'show_image' and media_block.settings.image == blank
      unless request.design_mode
        assign render_section = false
      endunless
    endif
  endif
-%}

{%- if render_section -%}
{{ 'section--image-with-text.css' | asset_url |  stylesheet_tag  }}
{% render 'section-custom-colors', section: section %}

<div
  id="{{ section.id }}"
  class="container section-spacing sm-down-no-default-padding-top sm-down-edge-to-edge color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>

  {% if background_block %}
    {% render 'block--section-background', block: background_block %}
  {% endif %}

  <div class="grid {{ section.settings.vertical_position }}">
    <div class="col-12 col-sm-6 col-md-{{ section.settings.media_width }} sm-br-img{% if section.settings.media_position == 'media_last' %} col-sm-order-2{% endif %}" {{ media_block.shopify_attributes }}>
      {%- if media_block.settings.media_link -%}<a class="media-link" href="{{ media_block.settings.media_link }}">{%- endif -%}
        {% case media_block.settings.media_toggle -%}
          {%- when 'show_video' -%}
            {%- render 'video_new',
              video_default: media_block.settings.video,
              aspect_ratio: media_block.settings.media_aspect_ratio,
              controls: media_block.settings.video_controls,
              autoplay: media_block.settings.video_autoplay
            -%}
          {% else %}
            {%- render 'picture',
              image_default: media_block.settings.image
              preload: preload_media,
              aspect_ratio: media_block.settings.media_aspect_ratio,
              sizes: sizes_string
            -%}
        {%- endcase -%}
      {%- if media_block.settings.media_link -%}</a>{%- endif -%}
      {%- if media_block.settings.show_floating_badge -%}
        {%- if media_block.settings.badge_subtitle != blank or media_block.settings.badge_text != blank -%}
          <div class="iwt-floating-badge">
            {%- if media_block.settings.badge_subtitle != blank -%}
              <span class="iwt-floating-badge__subtitle">{{ media_block.settings.badge_subtitle | escape }}</span>
            {%- endif -%}
            {%- if media_block.settings.badge_text != blank -%}
              <p class="iwt-floating-badge__text">{{ media_block.settings.badge_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="col-12 col-sm-6 col-md-{{ md_text_col_width }} p-page sm-p-0 text-align-{{ section.settings.mobile_alignment }} sm-text-align-{{ section.settings.desktop_alignment }}">
      {% render 'content-blocks',
        use_container: true,
        single_button_classes: single_button_width_classes,
        color_scheme: section.settings.color_scheme,
        sm_full_width_buttons: section.settings.sm_full_width_buttons,
        full_width_buttons: section.settings.full_width_buttons %}
    </div>
  </div>
</div>
{%- endif -%}

