{{ 'component-hotspots.css' | asset_url | stylesheet_tag  }}

{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  # Blocks to variables
  assign media_block = section.blocks | where: 'type', 'image' | first
  assign hotspot_blocks = section.blocks | where: 'type', 'hotspot'
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign content_blocks_count = section.blocks.size | minus: hotspot_blocks.size

  if media_block and custom_spacing
    assign content_blocks_count = content_blocks_count | minus: 2
  elsif media_block or custom_spacing
    assign content_blocks_count = content_blocks_count | minus: 1
  endif

  # Sizes string for responsive image
  capture sizes
    render 'img_sizes', ipr_mobile: 1, ipr_tablet: 2, ipr_desktop: 2
  endcapture

  # Column classes
  assign content_width = section.settings.content_width
  assign media_position = section.settings.media_position

  # - widths
  assign media_column_classes = 'the-media col-12 col-sm-6'
  assign content_column_classes = 'the-content col-12 col-sm-6 '
  if content_width == 'narrow'
    assign content_column_classes = content_column_classes | append: ' col-md-4'
  endif

  # - order
  if media_position == 'right' or media_position == 'bottom'
    assign media_column_classes = media_column_classes | append: ' col-sm-order-2'
  endif

  # - offsets
  if media_position == 'top' or media_position == 'bottom' or content_blocks_count == 0
    assign media_column_classes = media_column_classes | append: ' col-sm-offset-4'
    if content_width == 'wide'
      assign content_column_classes = content_column_classes | append: ' col-sm-offset-4'
    elsif content_width == 'narrow'
      assign content_column_classes = content_column_classes | append: ' col-sm-offset-4 col-md-offset-5'
    endif
  elsif content_width == 'narrow' and media_position == 'left'
    assign content_column_classes = content_column_classes | append: ' col-md-offset-8'
  elsif content_width == 'narrow' and media_position == 'right'
    assign content_column_classes = content_column_classes | append: ' col-md-offset-2'
    assign media_column_classes = media_column_classes | append: ' col-sm-offset-7'
  endif

  # Single button width classes
  assign single_button_width_classes = ''
  if section.settings.full_width_buttons
    assign single_button_width_classes = 'sm-down-btn--full'
  endif

  # Hotspot color
  assign hotspot_pos_array = hotspot_blocks[0].settings.hotspots_pos_array | split: '|'
-%}

<div
  id="{{ section.id }}"
  class="container section-spacing sm-down-edge-to-edge overflow-hidden custom-child-for-animation{% if section.settings.enable_full_width %} full-width{% endif %} color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div class="grid col-align-items-center col-justify-items-center sm-br-img" {% if section.settings.section_bg != blank %} style="background: {{ section.settings.section_bg }};"{% endif %}>
    <div class="{{ media_column_classes }}">
      <div
        {% if media_block -%}{{ media_block.shopify_attributes }}{% endif %}
        class="hotspot-container mt mb sm-mt sm-mb sm-br-img"
        style="
          --mt: {{ media_block.settings.padding_top | append: 'px' }};
          --mb: {{ media_block.settings.padding_bottom | append: 'px' }};
          --sm-mt: {{ media_block.settings.sm_padding_top | append: 'px' }};
          --sm-mb: {{ media_block.settings.sm_padding_bottom | append: 'px' }};
          --overlay-opacity: {{ media_block.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};
        ">

        {%- render 'picture',
          image_default: media_block.settings.image,
          aspect_ratio: media_block.settings.media_aspect_ratio,
          preload: preload_media,
          sizes: sizes -%}

        {%- for block in hotspot_blocks -%}
          {% if hotspot_pos_array != blank %}
            {% assign current_pos = hotspot_pos_array[forloop.index0] | split: ',' %}
            {% assign title_position = current_pos[0] %}
            {% assign vertical_position = current_pos[1] %}
            {% assign horizontal_position = current_pos[2] %}
          {% else %}
            {% assign title_position = block.settings.title_position %}
            {% assign vertical_position = block.settings.vertical_position %}
            {% assign horizontal_position = block.settings.horizontal_position %}
          {% endif %}
          <button type="button"
            data-open="modal-{{ section.id }}?slide={{ forloop.index }}"
            class="hotspot animated {%- if section.settings.numbered_hotspots %} hotspot--number{% endif %} color--{{ section.settings.color_hotspot }}"
            {{ block.shopify_attributes }}
            aria-haspopup="dialog"
            {%- if block.settings.title != blank -%}
              aria-label="{{ 'accessibility.view_hotspot' | t: title: block.settings.title | escape }}"
            {%- else -%}
              aria-label="{{ 'accessibility.view_hotspot_number' | t: number: forloop.index }}"
            {%- endif -%}
            style="
              --hotspot-vertical-position: {{ vertical_position }}%;
              --hotspot-horizontal-position: {{ horizontal_position }}%;
            ">
            {%- if section.settings.numbered_hotspots -%}
              <span class="hotspot-dot">
                {{- forloop.index -}}
              </span>
            {%- else -%}
              <span class="hotspot-dot">
                {%- render 'icon-plus' -%}
              </span>
            {%- endif %}
            {%- if block.settings.title != blank -%}
              <span class="hotspot-title position--{{ title_position }} size--tiny {% if section.settings.sm_down_hide_hotspot_titles %} sm-down-hide{% endif %}">{{ block.settings.title | replace: '[br]', '<br>'  }}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>
    {%- if content_blocks_count > 0 -%}
    <div class="{{ content_column_classes }} p-page pt-24 pb-24 sm-p-0 sm-pt-24 sm-pb-24 text-align-{{ section.settings.mobile_alignment }} sm-text-align-{{ section.settings.desktop_alignment }}">
      {%- render 'content-blocks',
        use_container: true,
        single_button_classes: single_button_width_classes,
        color_scheme: section.settings.color_scheme -%}
    </div>
    {%- endif -%}
  </div>
</div>

{% render 'modal-slider', modal_slides: hotspot_blocks %}

