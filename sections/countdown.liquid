{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign timer_block = section.blocks | where: 'type', 'timer' | first

-%}

{% capture content_blocks %}
  {% render 'content-blocks', color_scheme: section.settings.color_scheme %}
{% endcapture %}

{{ 'component-count-down.css' | asset_url | stylesheet_tag: preload: preload_media }}
<script type="text/javascript" defer src="{{ 'component-countdown.js' | asset_url }}"></script>

<div
  id="{{ section.id }}"
  class="container section-spacing no-default-padding color-{{ section.settings.color_scheme }}"
  {% if custom_spacing != blank -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div class="grid{% if section.settings.card_style %} card-style{% endif %}">
    {% if content_blocks != blank %}
      <div class="col-12 col-md-4 text-align-{{ section.settings.text_alignment }} sm-text-align-{{ section.settings.sm_text_alignment }}">
        {% render 'content-blocks', color_scheme: section.settings.color_scheme %}
      </div>
    {% endif %}
    <div class="col-12 col-md-8 {% if content_blocks == blank %} col-md-offset-3 {% endif %} text-align-center">
      {% assign the_date = timer_block.settings.the_date | date: '%Y-%m-%dT%H:%M%z' %}
      <count-down data-timer-for="{{ section.id }}" class="count-down mt sm-mt {{ timer_block.settings.time_units }}" end-date="{{ the_date }}" style="--mt: {{ timer_block.settings.margin_top | append: 'px' }}; --sm-mt: {{ timer_block.settings.sm_margin_top | append: 'px' }}" {{ timer_block.shopify_attributes }}>
        <time datetime="{{ the_date }}" class="{{ timer_block.settings.units_spacing }}">
          <div class="count-down__item">
            <span class="count-down__unit subheading size--tiny">{{ 'sections.countdown.days' | t }}</span>
            <span class="count-down__number h1 days {{ timer_block.settings.sm_size_multiplier }} {{ timer_block.settings.size_multiplier }}">--</span>
          </div>
          <div class="count-down__item">
            <span class="count-down__unit subheading size--tiny">{{ 'sections.countdown.hours' | t }}</span>
            <span class="count-down__number h1 hours {{ timer_block.settings.sm_size_multiplier }} {{ timer_block.settings.size_multiplier }}">--</span>
          </div>
          <div class="count-down__item">
            <span class="count-down__unit subheading size--tiny">{{ 'sections.countdown.minutes' | t }}</span>
            <span class="count-down__number h1 minutes {{ timer_block.settings.sm_size_multiplier }} {{ timer_block.settings.size_multiplier }}">--</span>
          </div>
          <div class="count-down__item">
            <span class="count-down__unit subheading size--tiny">{{ 'sections.countdown.seconds' | t }}</span>
            <span class="count-down__number h1 seconds {{ timer_block.settings.sm_size_multiplier }} {{ timer_block.settings.size_multiplier }}">--</span>
          </div>
        </time>
      </count-down>
    </div>
  </div>
</div>

<script>
  var checkIfCountdownEnded = (sectionId) => {
    const countdown = document.querySelector(`#${sectionId} count-down`);

    if (countdown) {
      if(countdown.getAttribute('data-ended')) {
        document.querySelector(`#${sectionId} .post-content`).classList.remove('hidden');
        document.querySelector(`#${sectionId} .pre-content`).classList.add('hidden');
      }
    }
  };

  setTimeout(() => {
    checkIfCountdownEnded('{{ section.id }}');
  }, 500);

  document.addEventListener('shopify:section:load', function(event) {
    if(event.detail.sectionId === '{{ section.id }}') {
      checkIfCountdownEnded('{{ section.id }}');
    }
  });

  document.addEventListener('shopify:section:select', function(event) {
    if(event.detail.sectionId === '{{ section.id }}') {
      checkIfCountdownEnded('{{ section.id }}');
    }
  });

  document.addEventListener('countdownEnded-{{ section.id }}', function() {
    console.log('Event triggered - Countdown ended');
    document.querySelector('#{{ section.id }} .pre-content').classList.add('hidden');
    document.querySelector('#{{ section.id }} .post-content').classList.remove('hidden');
  });
</script>

