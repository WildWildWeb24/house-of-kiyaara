{%- if section.settings.icon == 'stars' -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign ipr_desktop    = section.settings.items_per_row_desktop
  assign ipr_tablet     = section.settings.items_per_row_tablet
  assign ipr_mobile     = 1
  assign slider_mobile  = true
  assign slider_desktop = true

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign header_block = section.blocks | where: 'type', 'section_header' | first
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial'

  assign slider_items_count = testimonial_blocks | size
-%}

<div
  id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>

  {%- if header_block != blank -%}
    {% render 'section-header',
      size_multiplier: header_block.settings.size_multiplier,
      sm_size_multiplier: header_block.settings.sm_size_multiplier,
      text_align: header_block.settings.text_alignment,
      subtitle: header_block.settings.subtitle,
      subtitle_tag: header_block.settings.subtitle_tag,
      title: header_block.settings.title,
      title_tag: header_block.settings.title_tag,
      text: header_block.settings.text,
      shopify_attr: header_block.shopify_attributes %}
  {%- endif -%}

  {%- if testimonial_blocks.size > 0 -%}
  <gridy-slider
    id="slider-{{ section.id }}"
    class="gridy-slider show-overflow-items"
    data-mobile-enabled="{{ slider_mobile }}"
    data-tablet-enabled="{{ slider_desktop }}"
    data-desktop-enabled="{{ slider_desktop }}"
    data-ipr-mobile="{{ ipr_mobile }}"
    data-ipr-tablet="{{ ipr_tablet }}"
    data-ipr-desktop="{{ ipr_desktop }}"
    data-arrows="true"
    data-progress-bar="true"
    data-autoplay="{{ section.settings.autoplay}}"
    data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
    data-overflow-visible="true">
    <div class="grid grid-gap gridy-track scrollbar--hide track-inner-padding grid grid-cols-{{ ipr_mobile }} sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}">
      {% for block in testimonial_blocks %}
        {% capture card_content %}
          {%- if section.settings.icon == 'stars' -%}
            {% render 'rating', rating_value: block.settings.stars, custom_classes: 'mb-16' %}
          {% elsif section.settings.icon == 'quotation_mark' %}
            <div class="quotation-mark h2 size--outrageous"><em>“</em></div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="h3 mb-16 {{ section.settings.sm_size_multiplier }} {{ section.settings.size_multiplier }}">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.testimonial != blank -%}
            <div class="rte mb-16 {{ section.settings.sm_size_multiplier }} {{ section.settings.size_multiplier }}">{{ block.settings.testimonial }}</div>
          {%- endif -%}

          {%- if block.settings.author_image != blank -%}
            {% render 'picture', image_default: block.settings.author_image, aspect_ratio: 'square', class: 'testimonial-author-image', sizes: '140px' %}
          {%- endif -%}

          {%- if block.settings.author != blank -%}
            <cite class="size--small style--subdued">{{ block.settings.author | escape }}</cite>
          {%- endif -%}
        {% endcapture %}

        {% render 'card-testimonial',
          card_content: card_content,
          card_bg: section.settings.card_bg,
          text_align: section.settings.alignment %}
      {% endfor %}
    </div>

    {%- liquid
      assign arrows_hide_class = ''
      if slider_items_count <= ipr_desktop
        assign arrows_hide_class = arrows_hide_class | append: ' md-hide'
      endif
      if slider_items_count <= ipr_tablet
        assign arrows_hide_class = arrows_hide_class | append: ' sm-to-md-hide'
      endif
      if slider_items_count <= ipr_mobile
        assign arrows_hide_class = arrows_hide_class | append: ' sm-down-hide'
      endif

      render 'gridy-arrows-and-progress', class: arrows_hide_class, ipr_desktop: ipr_desktop, ipr_tablet: ipr_tablet, ipr_mobile: ipr_mobile, items_count: slider_items_count
    -%}
  </gridy-slider>
  {%- endif -%}
</div>

