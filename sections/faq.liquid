{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  assign sizes_string = '(min-width: 768px) calc((100vw - 72px) / 2), 100vw)'

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign media_block = section.blocks | where: 'type', 'image' | first
  assign header_block = section.blocks | where: 'type', 'section_header' | first
  assign the_questions = section.blocks | where: 'type', 'question'

  if section.settings.enable_full_width == false
    assign max_media_width = settings.content_ideal_width | minus: 72 | divided_by: 2
    assign sizes_string = '(min-width:' | append: settings.content_ideal_width | append: 'px) ' | append: max_media_width | append: 'px, (min-width: 768px) calc((100vw - 72px) / 2), 100vw)'
  endif

  if section.settings.title_style == 'h3'
    assign title_html = '<h3 class="h5 size--small">[title]</h3>'
  elsif section.settings.title_style == 'subheading'
    assign title_html = '<h3 class="h5 size--small subheading">[title]</h3>'
  elsif section.settings.title_style == 'body-text'
    assign title_html = '<h3 class="font-body">[title]</h3>'
  else
    assign title_html = '<h3 class="font-body"><strong>[title]</strong></h3>'
  endif
-%}


<div
  id="{{ section.id }}"
  class="container section-spacing sm-down-no-default-padding-top sm-down-edge-to-edge color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div class="grid grid-cols-1 {% if media_block != blank %}sm-grid-cols-2 {% endif %}col-align-items-center col-justify-items-center">
    {%- if media_block != blank -%}
      <div class="sm-br-img{% if section.settings.media_position == 'media_last' %} col-sm-order-2{% endif %}" {{ media_block.shopify_attributes }}>
        {% case media_block.settings.media_type -%}
          {%- when 'image' -%}
            {%- render 'picture',
              image_default: media_block.settings.image
              preload: preload_media,
              aspect_ratio: media_block.settings.media_aspect_ratio,
              sizes: sizes_string
            -%}
          {%- when 'video' -%}
            {%- render 'video_new',
              video_default: media_block.settings.video,
              aspect_ratio: media_block.settings.media_aspect_ratio,
              controls: media_block.settings.video_controls,
              autoplay: media_block.settings.video_autoplay
            -%}
        {%- endcase -%}
      </div>
    {%- endif -%}

    <div class="p-page pt-12 pb-24 sm-p-0 sm-pt-24 sm-pb-24 {{ section.settings.content_width }} text-align-left sm-text-align-left">
      {%- if header_block != blank -%}
        {% render 'section-header',
          size_multiplier: header_block.settings.size_multiplier,
          sm_size_multiplier: header_block.settings.sm_size_multiplier,
          text_align: header_block.settings.text_alignment,
          subtitle: header_block.settings.subtitle,
          subtitle_tag: header_block.settings.subtitle_tag,
          title: header_block.settings.title,
          title_tag: header_block.settings.title_tag,
          text: header_block.settings.text,
          shopify_attr: header_block.shopify_attributes %}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary>
              {{ title_html | replace: '[title]', block.settings.title }}
              {% render 'icon-caret' %}
            </summary>
            <div class="content faq-item__body rte">
              {%- if block.settings.media_type == 'image' and block.settings.image != blank -%}
                <div class="faq-item-media br-img mb-12">
                  {% render 'picture',
                    image_default: block.settings.image,
                    sizes: '(min-width: 768px) calc((100vw - 72px) / 2), 50vw)',
                  %}
                </div>
              {%- elsif block.settings.media_type == 'video' and block.settings.video != blank -%}
                <div class="faq-item-media br-img mb-12">
                  {% render 'video_new', video_default: block.settings.video, autoplay: false %}
                </div>
              {%- endif -%}
              {{ block.settings.text }}
            </div>
          </details>
        {%- elsif block.type == 'subheading' -%}
          <h3 class="h5 size--small subheading pb-12 pt-12 mt-24" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- render 'schema-faq', items: the_questions, context: 'block' -%}

