{% if section.settings.enable_full_width and section.settings.sm_enable_full_width %}
  {% assign full_width = 'edge-to-edge' %}
{% elsif section.settings.enable_full_width %}
  {% assign full_width = 'sm-down-edge-to-edge' %}
{% elsif section.settings.sm_enable_full_width %}
  {% assign full_width = 'sm-edge-to-edge' %}
{% else %}
  {% assign full_width = '' %}
{% endif %}

<div id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }} {{ full_width }}"
  style="--mt: {{ section.settings.margin_top | append: 'px' }}; --sm-mt: {{ section.settings.sm_margin_top | append: 'px' }}; --pt: {{ section.settings.padding_top | append: 'px' }}; --pb: {{ section.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ section.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ section.settings.sm_padding_bottom | append: 'px' }};"
  >
  {% content_for 'blocks' %}
</div>

{% schema %}
  {
    "name": "t:sections.ai_section.name",
    "class": "section--ai-section",
    "tag": "section",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.ai-section.info"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "default",
        "label": "t:sections.colors.color_scheme.label"
      },
      {
        "type": "header",
        "content": "t:sections.headers.desktop_layout"
      },
      {
        "type": "checkbox",
        "id": "sm_enable_full_width",
        "label": "t:sections.layout.section_width.full_width",
        "default": true
      },
      {
        "type": "range",
        "id": "sm_margin_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.layout.margin_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "sm_padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.layout.paddings.top",
        "default": 0
      },
      {
        "type": "range",
        "id": "sm_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.layout.paddings.bottom",
        "default": 0
      },
      {
        "type": "header",
        "content": "t:sections.headers.mobile_layout"
      },
      {
        "type": "checkbox",
        "id": "enable_full_width",
        "label": "t:sections.layout.section_width.full_width",
        "default": true
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.layout.margin_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.layout.paddings.top",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.layout.paddings.bottom",
        "default": 0
      }
    ],
    "blocks": [{ "type": "@theme" }, { "type": "@app" }],
    "presets": [{
      "name": "t:sections.ai_section.name"
    }]
  }
{% endschema %}