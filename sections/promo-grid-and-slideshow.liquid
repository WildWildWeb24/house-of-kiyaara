{{ 'section-promo-grid-and-slideshow.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  # Banner blocks
  assign banner_blocks = section.blocks | reject: 'type', 'custom_spacing'
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first

  # Items per row
  assign ipr_desktop = section.settings.section_columns_desktop
  assign ipr_tablet = section.settings.section_columns_tablet
  assign ipr_mobile = section.settings.section_columns_mobile
  assign full_width = section.settings.enable_full_width

  # Aspect ratio
  assign aspect_ratio = section.settings.block_aspect_ratio | append: ' sm-' | append: section.settings.sm_block_aspect_ratio

  # Sizes string for responsive image
  capture sizes
    render 'img_sizes', full_width: full_width, ipr_mobile: ipr_mobile, ipr_tablet: ipr_tablet, ipr_desktop: ipr_desktop
  endcapture

  # Slider settings
  assign slider_items_count = banner_blocks | size
  assign slider_mobile = false
  assign slider_desktop = false

  if section.settings.layout_mobile == 'slide'
    assign slider_mobile = true
  endif
  if section.settings.layout_desktop == 'slide'
    assign slider_desktop = true
  endif
-%}

<div
  id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }}{% if section.settings.sm_down_edge_to_edge %} sm-down-edge-to-edge{% endif %}{% if full_width %} edge-to-edge{% endif %}"
  {% if custom_spacing -%}
    style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>

  <gridy-slider
    id="slider-{{ section.id }}"
    class="gridy-slider {%- unless full_width %} show-overflow-items {%- endunless %}"
    data-mobile-enabled="{{ slider_mobile }}"
    data-tablet-enabled="{{ slider_desktop }}"
    data-desktop-enabled="{{ slider_desktop }}"
    data-ipr-mobile="{{ ipr_mobile }}"
    data-ipr-tablet="{{ ipr_tablet }}"
    data-ipr-desktop="{{ ipr_desktop }}"
    data-arrows="true"
    data-sliding-behavior="{{ section.settings.sliding_behavior }}"
    data-autoplay="{{ section.settings.autoplay}}"
    data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
    data-progress-bar="true"
    {% unless full_width %}data-overflow-visible="true"{% endunless -%}>

    <div
      class="grid gridy-track scrollbar--hide sm-gap grid-cols-{{ ipr_mobile }} sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}"
      style="
        --gap: {{ section.settings.grid_gap }}px;
        --sm-gap: {{ section.settings.sm_grid_gap }}px;">
      {%- for block in banner_blocks -%}
        {% if preload_media and forloop.index > ipr_desktop %}
          {% assign preload_media = false %}
        {% endif %}
        <div class="banner banner--{{ block.type }} color-{{ block.settings.color_scheme }} {{ aspect_ratio }}{% if block.settings.text_alignment != blank %} {{ block.settings.text_alignment }}{% endif %}{% if section.settings.rounded_corners %} sm-down-br-img{% endif %}{% if section.settings.sm_rounded_corners %} sm-br-img{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.media_link != blank -%}
            <a href="{{ block.settings.media_link }}">
            {%- endif -%}

            {%- if block.type == 'image' -%}
              {% render 'picture',
                image_default: block.settings.image,
                image_mobile: block.settings.image_mobile,
                preload: preload_media,
                aspect_ratio: aspect_ratio,
                sizes: sizes
              %}
            {%- elsif block.type == 'video' -%}
              {%- render 'video_new', video_default: block.settings.video, video_mobile: block.settings.video_mobile -%}
            {%- endif -%}

            {%- if block.settings.title != blank or block.settings.button_label != blank and block.settings.media_link != blank -%}
              <div class="banner-overlay overlay-colors flex {{ block.settings.content_alignment }} p sm-p" style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.00 }}; --p: {{ section.settings.padding }}px; --sm-p: {{ section.settings.sm_padding }}px;">
                {{ block.settings.title }}
                {% if block.settings.button_label != blank and block.settings.media_link != blank %}
                  <span class="btn btn--{{ block.settings.button_style }} mt-8">{{ block.settings.button_label }}</span>
                {% endif %}
              </div>
            {%- endif -%}

            {%- if block.settings.media_link != blank -%}
            </a>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

    {%- liquid
      assign arrows_hide_class = ''
      if slider_items_count <= ipr_desktop
        assign arrows_hide_class = arrows_hide_class | append: ' md-hide'
      endif
      if slider_items_count <= ipr_tablet
        assign arrows_hide_class = arrows_hide_class | append: ' sm-to-md-hide'
      endif
      if slider_items_count <= ipr_mobile
        assign arrows_hide_class = arrows_hide_class | append: ' sm-down-hide'
      endif

      render 'gridy-arrows-and-progress', class: arrows_hide_class, ipr_desktop: ipr_desktop, ipr_tablet: ipr_tablet, ipr_mobile: ipr_mobile, items_count: slider_items_count
    -%}
  </gridy-slider>
</div>

