{%- liquid
  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
-%}
<div
  id="{{ section.id }}"
  class="container section-spacing color-{{ section.settings.color_scheme }}"
  style="--ideal-width: 65ch;{% if custom_spacing -%} --mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};{%- endif %}">
  <div class="section-header mb-gutter text-align-{{ section.settings.heading_text_align }}">
    <h2 class="section-title {{ section.settings.size_multiplier }} {{ section.settings.sm_size_multiplier }}">{{ page.title }}</h2>
  </div>

  <div class="rte">
    {{ page.content }}
  </div>
</div>

{% schema %}
  {
    "name": "t:sections.main-page.name",
    "class": "section--main-page",
    "tag": "section",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "default",
        "label": "t:sections.colors.color_scheme.label"
      },
      {
        "type": "text_alignment",
        "id": "heading_text_align",
        "label": "t:sections.main-page.settings.heading_text_align.label",
        "default": "left"
      },
      {
        "type": "header",
        "content": "t:sections.headers.desktop_layout"
      },
      {
          "type": "select",
          "id": "sm_size_multiplier",
          "label": "t:sections.typography.heading_size",
          "default": "sm-size--default",
          "options": [
            {
              "value": "sm-size--tiny",
              "label": "t:sections.typography.size_options.tiny"
            },
            {
              "value": "sm-size--small",
              "label": "t:sections.typography.size_options.small"
            },
            {
              "value": "sm-size--default",
              "label": "t:sections.typography.size_options.default"
            },
            {
              "value": "sm-size--large",
              "label": "t:sections.typography.size_options.large"
            },
            {
              "value": "sm-size--huge",
              "label": "t:sections.typography.size_options.huge"
            },
            {
              "value": "sm-size--gigantic",
              "label": "t:sections.typography.size_options.gigantic"
            },
            {
              "value": "sm-size--outrageous",
              "label": "t:sections.typography.size_options.outrageous"
            }
          ]
        },
      {
        "type": "header",
        "content": "t:sections.headers.mobile_layout"
      },
      {
          "type": "select",
          "id": "size_multiplier",
          "label": "t:sections.typography.heading_size",
          "default": "size--default",
          "options": [
            {
              "value": "size--tiny",
              "label": "t:sections.typography.size_options.tiny"
            },
            {
              "value": "size--small",
              "label": "t:sections.typography.size_options.small"
            },
            {
              "value": "size--default",
              "label": "t:sections.typography.size_options.default"
            },
            {
              "value": "size--large",
              "label": "t:sections.typography.size_options.large"
            },
            {
              "value": "size--huge",
              "label": "t:sections.typography.size_options.huge"
            },
            {
              "value": "size--gigantic",
              "label": "t:sections.typography.size_options.gigantic"
            },
            {
              "value": "size--outrageous",
              "label": "t:sections.typography.size_options.outrageous"
            }
          ]
        }
    ],
    "blocks": [
      {
        "name": "t:blocks.custom_spacing.name",
        "type": "custom_spacing",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "t:blocks.custom_spacing.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.desktop_layout"
          },
          {
            "type": "range",
            "id": "sm_margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          },
          {
            "type": "header",
            "content": "t:sections.headers.mobile_layout"
          },
          {
            "type": "range",
            "id": "margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          }
        ]
      }
    ]
  }
{% endschema %}