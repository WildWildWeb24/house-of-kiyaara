{{ 'component-popup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign localstorage_key = shop.permanent_domain | append: '-newsletter-modal-' | append: section.settings.frequency | handleize
  assign media_block = section.blocks | where: 'type', 'image' | first
-%}

<newsletter-popup id="modal-popup" class="popup popup--narrow color-{{ settings.color_scheme_modals }}" data-section-id="{{- section.id -}}" data-modal data-parent data-test-mode="{{- section.settings.test_mode -}}" data-frequency="{{- section.settings.frequency -}}" data-delay="{{- section.settings.delay | times: 1000 -}}" data-storage-key="{{- localstorage_key -}}" style="display: none; opacity: 0;">
  <div class="popup-dialog">
    {% render 'close-button', button_class: 'popup-close', context: 'newsletter-popup' %}
    {% if media_block != blank %}
      {%- render 'picture', aspect_ratio: 'natural', image_default: media_block.settings.image, sizes: '(max-width: 480px) 100vw, 480px' -%}
    {% endif %}
    <div class="p-24 sm-p-40 flex vertical horizontal-center">
      {% render 'content-blocks' %}
    </div>
  </div>
</newsletter-popup>

<script type="text/javascript" defer src="{{ 'component-newsletter-popup.js' | asset_url }}"></script>

{% schema %}
{
  "name": "t:sections.popup-newsletter.name",
  "class": "section--popup-newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "test_mode",
      "label": "t:sections.popup-newsletter.settings.test_mode.label",
      "default": false,
      "info": "t:sections.popup-newsletter.settings.test_mode.info"
    },
    {
      "type": "header",
      "content": "t:sections.popup-newsletter.settings.header_for_display_options.content",
      "info": "t:sections.popup-newsletter.settings.header_for_display_options.info"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "t:sections.popup-newsletter.settings.delay.label",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 5,
      "unit": "sec",
      "info": "t:sections.popup-newsletter.settings.delay.info"
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "t:sections.popup-newsletter.settings.frequency.label",
      "options": [
        {
          "value": "once",
          "label": "t:sections.popup-newsletter.settings.frequency.options.once"
        },
        {
          "value": "1_day",
          "label": "t:sections.popup-newsletter.settings.frequency.options.1_day"
        },
        {
          "value": "3_days",
          "label": "t:sections.popup-newsletter.settings.frequency.options.3_days"
        },
        {
          "value": "7_days",
          "label": "t:sections.popup-newsletter.settings.frequency.options.7_days"
        },
        {
          "value": "14_days",
          "label": "t:sections.popup-newsletter.settings.frequency.options.14_days"
        },
        {
          "value": "30_days",
          "label": "t:sections.popup-newsletter.settings.frequency.options.30_days"
        },
        {
          "value": "60_days",
          "label": "t:sections.popup-newsletter.settings.frequency.options.60_days"
        },
        {
          "value": "90_days",
          "label": "t:sections.popup-newsletter.settings.frequency.options.90_days"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Heading will be fixed to the top of the popup. If you wish to adjust the heading's position, use the Text block."
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:inputs.text.title",
          "default": "Promotional popup"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Sign up to our newsletter and get 10% off your first order.</p>",
          "label": "t:inputs.text.text"
        },
        {
          "type": "header",
          "content": "t:sections.headers.desktop_layout"
        },
        {
          "type": "select",
          "id": "sm_size_multiplier",
          "label": "t:sections.typography.size_options.label",
          "default": "sm-size--default",
          "options": [
            {
              "value": "sm-size--tiny",
              "label": "t:sections.typography.size_options.tiny"
            },
            {
              "value": "sm-size--small",
              "label": "t:sections.typography.size_options.small"
            },
            {
              "value": "sm-size--default",
              "label": "t:sections.typography.size_options.default"
            },
            {
              "value": "sm-size--large",
              "label": "t:sections.typography.size_options.large"
            },
            {
              "value": "sm-size--huge",
              "label": "t:sections.typography.size_options.huge"
            },
            {
              "value": "sm-size--gigantic",
              "label": "t:sections.typography.size_options.gigantic"
            },
            {
              "value": "sm-size--outrageous",
              "label": "t:sections.typography.size_options.outrageous"
            }
          ]
        },
        {
          "type": "range",
          "id": "sm_margin_top",
          "label": "t:sections.layout.margin_top",
          "default": 0,
          "min": -10,
          "max": 60,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "t:sections.headers.mobile_layout"
        },
        {
          "type": "select",
          "id": "size_multiplier",
          "label": "t:sections.typography.size_options.label",
          "default": "size--default",
          "options": [
            {
              "value": "size--tiny",
              "label": "t:sections.typography.size_options.tiny"
            },
            {
              "value": "size--small",
              "label": "t:sections.typography.size_options.small"
            },
            {
              "value": "size--default",
              "label": "t:sections.typography.size_options.default"
            },
            {
              "value": "size--large",
              "label": "t:sections.typography.size_options.large"
            },
            {
              "value": "size--huge",
              "label": "t:sections.typography.size_options.huge"
            },
            {
              "value": "size--gigantic",
              "label": "t:sections.typography.size_options.gigantic"
            },
            {
              "value": "size--outrageous",
              "label": "t:sections.typography.size_options.outrageous"
            }
          ]
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "t:sections.layout.margin_top",
          "default": 0,
          "min": -10,
          "max": 60,
          "step": 1,
          "unit": "px"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:inputs.image_picker.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:b locks.button.name",
      "settings": [
        {
          "type": "text",
          "label": "t:inputs.text.button_label",
          "id": "btn_text"
        },
        {
          "type": "select",
          "label": "t:sections.buttons.style.label",
          "id": "btn_style",
          "options": [
            {
              "value": "btn",
              "label": "t:sections.typography.style_options.primary_button"
            },
            {
              "value": "btn btn--secondary",
              "label": "t:sections.typography.style_options.secondary_button"
            },
            {
              "value": "btn btn--link",
              "label": "t:inputs.url.link"
            }
          ],
          "default": "btn"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "t:inputs.url.button_link",
          "info": "t:sections.popup-newsletter.blocks.btn_link_info"
        },
        {
          "type": "header",
          "content": "t:sections.headers.layout"
        },
        {
          "id": "margin_top",
          "type": "range",
          "label": "t:sections.layout.margin_top",
          "info": "t:blocks.margin_info",
          "unit": "px",
          "default": 8,
          "min": 0,
          "max": 48,
          "step": 4
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.popup-newsletter.blocks.newsletter_name",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.headers.layout"
        },
        {
          "id": "margin_top",
          "type": "range",
          "label": "t:sections.layout.margin_top",
          "info": "t:blocks.margin_info",
          "unit": "px",
          "default": 8,
          "min": 0,
          "max": 48,
          "step": 4
        }
      ]
    }
  ]
}
{% endschema %}