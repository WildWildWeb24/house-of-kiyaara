{%- liquid
  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
-%}

<div id="{{ section.id }}"
  class="container section-spacing{% if section.settings.enable_full_width %} edge-to-edge{% endif %} color-{{ section.settings.color_scheme }}"
  {% if custom_spacing -%}
    style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  {{ section.settings.custom_liquid }}
</div>

{% schema %}
  {
    "name": "t:sections.custom-liquid.name",
    "class": "section--custom-liquid",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "aside"]
    },
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.custom-liquid.info"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "default",
        "label": "t:sections.colors.color_scheme.label"
      },
      {
        "type": "liquid",
        "id": "custom_liquid",
        "label": "t:sections.custom-liquid.settings.custom_liquid.label",
        "default": "<p class=\"text-align-center\">Custom liquid section can be used to create quick custom solutions</p>"
      },
      {
        "type": "checkbox",
        "id": "enable_full_width",
        "label": "t:sections.layout.section_width.full_width",
        "default": true
      }
    ],
    "blocks": [
      {
        "name": "t:blocks.custom_spacing.name",
        "type": "custom_spacing",
        "limit": 1,
        "settings": [
          {
            "type": "paragraph",
            "content": "t:blocks.custom_spacing.info"
          },
          {
            "type": "header",
            "content": "t:sections.headers.desktop_layout"
          },
          {
            "type": "range",
            "id": "sm_margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "sm_padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          },
          {
            "type": "header",
            "content": "t:sections.headers.mobile_layout"
          },
          {
            "type": "range",
            "id": "margin_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.margin_top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.top",
            "default": 0
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 2,
            "unit": "px",
            "label": "t:sections.layout.paddings.bottom",
            "default": 0
          }
        ]
      }
    ],
    "presets": [{
      "name": "t:sections.custom-liquid.name"
    }]
  }
{% endschema %}