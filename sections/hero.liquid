{%- liquid
  # Section index check
  if section.index == 1 and section.location == 'template'
    assign preload_media = true
  else
    assign preload_media = false
  endif

  # Blocks to variables
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
  assign media_block = section.blocks | where: 'type', 'image' | first
  assign button_blocks_count = section.blocks | where: 'type', 'button' | size

  # Layout classes
  assign section_layout_classes = 'height-' | append: section.settings.section_height | append: ' sm-height-' | append: section.settings.sm_section_height
  if section.settings.content_position contains 'contained'
    assign section_layout_classes = section_layout_classes | append: ' hero--sm-down-contained'
  endif

  # Section height
  assign section_height = section.settings.section_height
  assign sm_section_height = section.settings.sm_section_height

  if section_height == 'by_pixels'
    assign section_height = section.settings.pixel_height | append: 'px'
  endif

  if sm_section_height == 'by_pixels'
    assign sm_section_height = section.settings.sm_pixel_height | append: 'px'
  endif
-%}

{{ 'component-hero.css' | asset_url | stylesheet_tag: preload: preload_media }}

<div
  id="{{ section.id }}"
  class="container section-spacing no-default-padding color-{{ section.settings.color_scheme }} {{ section_layout_classes }}{% if section.settings.enable_full_width %} edge-to-edge{% else %} sm-down-edge-to-edge{% endif %}"
  {% if custom_spacing -%}
    style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>
  <div
    {% if section.settings.enable_parallax %}data-parallax{% endif %}
    class="hero{% unless section.settings.enable_full_width %} sm-br-img{% endunless %}{% unless media_block %} hero--no-media{% endunless %}"
    style="
      --section-height: {{ section_height }};
      --sm-section-height: {{ sm_section_height }};
    ">
    <div class="hero-media{% if section.settings.enable_parallax %} parallax-media{% endif %} {% unless section.settings.enable_full_width %} sm-br-img{% endunless %}" {% if media_block %}{{ media_block.shopify_attributes }}{% endif %}>
      {% case media_block.settings.media_toggle -%}
        {%- when 'show_image' -%}
          {%- render 'picture',
            image_default: media_block.settings.image,
            image_mobile: media_block.settings.image_mobile,
            preload: preload_media
          -%}
        {%- when 'show_video' -%}
          {%- render 'video_new',
            video_default: media_block.settings.video,
            video_mobile: media_block.settings.video_mobile
          -%}
      {%- endcase -%}
    </div>

    <div class="hero-text"{% if media_block %} style="--overlay-opacity: {{ media_block.settings.overlay_opacity | divided_by: 100.0 }};"{% endif %}>
      {% capture hero_text_container %}
        <div class="hero-text-container overlay-colors {{ section.settings.content_position | remove: 'contained ' }} {{ section.settings.sm_content_position | remove: 'contained ' }}">
          <div class="animate-children {{ section.settings.content_width }} text-align-{{ section.settings.text_alignment }} sm-text-align-{{ section.settings.sm_text_alignment }}">
            {% render 'content-blocks', color_scheme: section.settings.color_scheme %}
          </div>
        </div>
      {% endcapture %}

      {%- if button_blocks_count == 0 and section.settings.media_link != blank -%}
      <a href="{{ section.settings.media_link }}">
        {{ hero_text_container }}
      </a>
      {% else %}
        {{ hero_text_container }}
      {%- endif -%}
    </div>
  </div>
</div>

