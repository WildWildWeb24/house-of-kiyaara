{{ 'component-tabs.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign placeholder_prefix = 'product-'
  assign product_limit = section.settings.product_limit
  assign view_all = section.settings.view_all
  assign tab_title_tag = section.settings.tab_title_tag
  assign tab_title_style = section.settings.tab_title_style
  assign text_align = section.settings.text_alignment
  assign size_multiplier = section.settings.size_multiplier
  assign sm_size_multiplier = section.settings.sm_size_multiplier

  assign ipr_desktop = section.settings.products_per_row_desktop
  assign ipr_tablet = section.settings.products_per_row_tablet
  assign ipr_mobile = section.settings.products_per_row_mobile
  assign slider_mobile = false
  assign slider_desktop = false
  assign slide_peek = false

  capture sizes
    render 'img_sizes', ipr_mobile: ipr_mobile, ipr_tablet: ipr_tablet, ipr_desktop: ipr_desktop
  endcapture

  # Slider booleans
  if section.settings.layout_mobile contains 'slide'
    assign slider_mobile = true
  endif
  if section.settings.layout_desktop == 'slide'
    assign slider_desktop = true
  endif
  if section.settings.layout_mobile contains 'peek'
    assign slide_peek = true
  endif

  # Card thumbnail class
  if section.settings.enable_card_thumbnail
    assign card_layout_class = 'layout--thumbnail'
  endif

  # Blocks to variables
  assign header_block = section.blocks | where: 'type', 'section_header' | first
  assign custom_spacing = section.blocks | where: 'type', 'custom_spacing' | first
-%}

{% style %}
  @media screen and (max-width: 767px) {
    {% if text_align == 'text-align-left' %}
      .tab-title:last-child {
        margin-right: auto;
      }
    {% elsif text_align == 'text-align-right' %}
      .tab-title:first-child {
        margin-left: auto;
      }
    {% else %}
      .tab-title:last-child {
        margin-right: auto;
      }
      .tab-title:first-child {
        margin-left: auto;
      }
    {% endif %}
  }

  @media screen and (min-width: 768px) {
    {% if text_align == 'text-align-left' %}
      .tab-titles {
        justify-content: flex-start;
      }
    {% elsif text_align == 'text-align-right' %}
      .tab-titles {
        justify-content: flex-end;
      }
    {% else %}
      .tab-titles {
        justify-content: center;
      }
    {% endif %}
  }
{% endstyle %}

{% capture tab_titles %}
  {% assign first_tab_title = true %}
  <div class="tab-titles scrollbar--hide width-auto mb-16" data-tab-titles>
    {% for block in section.blocks %}
      {% unless block.type == 'section_header' or block.type == 'custom_spacing' %}
        <button class="tab-title pt-16 pb-16 pl-24 sm-pl-0{% if first_tab_title %} is-active{% endif %}{% unless first_tab_title %} style--subdued{% endunless %}"
          data-tab-title="{{ block.id }}"
        >
          <{{ tab_title_tag | default: 'h2' }} class="{{ tab_title_style }} mb-4 {{ size_multiplier }} {{ sm_size_multiplier }}">
            {{- block.settings.tab_title | newline_to_br -}}
          </{{ tab_title_tag | default: 'h2' }}>
        </button>
        {% assign first_tab_title = false %}
      {% endunless %}
    {% endfor %}
  </div>
{% endcapture %}

{% capture tab_contents %}
  {% assign hidden = false %}
  <div class="tab-contents">
    {% for block in section.blocks %}
      {% if block.type == "section_header" or block.type == "custom_spacing" %}
        {% continue %}
      {% endif %}

      {% liquid
        if block.type == 'collection-tab'
          assign products = block.settings.collection.products
        elsif block.type == 'products-tab'
          assign products = block.settings.product_list
        endif

        if products == nil
          assign slider_items_count = 10
        elsif product_limit < products.count
          assign slider_items_count = product_limit
        else
          assign slider_items_count = products.count
        endif
      %}

      <gridy-slider
        id="slider-{{ section.id }}"
        class="gridy-slider show-overflow-items tab-content{% if hidden %} hidden{% endif %}"
        data-mobile-enabled="{{ slider_mobile }}"
        data-tablet-enabled="{{ slider_desktop }}"
        data-desktop-enabled="{{ slider_desktop }}"
        data-ipr-mobile="{{ ipr_mobile }}"
        data-ipr-tablet="{{ ipr_tablet }}"
        data-ipr-desktop="{{ ipr_desktop }}"
        data-arrows="true"
        data-progress-bar="true"
        data-sliding-behavior="{{ section.settings.sliding_behavior }}"
        data-autoplay="{{ section.settings.autoplay | default: false }}"
        data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
        data-tab-content="{{ block.id }}"
        data-overflow-visible="true">
        <div class="grid grid-gap gridy-track scrollbar--hide grid-cols-{{ ipr_mobile }} sm-grid-cols-{{ ipr_tablet }} md-grid-cols-{{ ipr_desktop }}{% if slider_mobile %} track-inner-padding{% endif %}{% if slide_peek %} slide-peek{% endif %}">
          {% if products and products != empty %}
            {% for product in products limit: product_limit %}
              {%- render 'card-product',
                product: product,
                card_layout_class: card_layout_class,
                sizes: sizes
              -%}
            {% endfor %}
          {% else %}
            {% for i in (1..10) limit: product_limit %}
              {% if i > 6 %}
                {% assign placeholder_index = i | minus: 6 %}
                {%- assign svg_name = placeholder_prefix | append: placeholder_index -%}
              {% else %}
                {%- assign svg_name = placeholder_prefix | append: i -%}
              {% endif %}

              {%- render 'card-product',
                svg_name: svg_name,
                card_layout_class: card_layout_class
              -%}
            {% endfor %}
          {% endif %}
        </div>

        {%- liquid
          assign arrows_hide_class = ''
          if slider_items_count <= ipr_desktop
            assign arrows_hide_class = arrows_hide_class | append: ' md-hide'
          endif
          if slider_items_count <= ipr_tablet
            assign arrows_hide_class = arrows_hide_class | append: ' sm-to-md-hide'
          endif
          if slider_items_count <= ipr_mobile
            assign arrows_hide_class = arrows_hide_class | append: ' sm-down-hide'
          endif

          render 'gridy-arrows-and-progress', class: arrows_hide_class, ipr_desktop: ipr_desktop, ipr_tablet: ipr_tablet, ipr_mobile: ipr_mobile, items_count: slider_items_count
        -%}
      </gridy-slider>
      {% if block.type == 'collection-tab' and view_all and products.size > product_limit %}
        <div class="mt-12 p-page sm-p-0 text-align-center{% if hidden %} hidden{% endif %}" data-tab-collection-link="{{ block.id }}">
          <a class="btn btn--link size--small" href="{{ block.settings.collection.url }}">
            {{- 'sections.collection_switcher.view_all' | t -}}
          </a>
        </div>
      {% endif %}
      {% assign hidden = true %}
    {% endfor %}
  </div>
{% endcapture %}

{% render 'section-custom-colors', section: section %}
<div
  id="{{ section.id }}"
  class="collection-switcher section-spacing color-{{ section.settings.color_scheme }}{% if slider_mobile %} sm-down-edge-to-edge{% endif %}"
  {% if custom_spacing -%}
  style="--mt: {{ custom_spacing.settings.margin_top | append: 'px' }}; --sm-mt: {{ custom_spacing.settings.sm_margin_top | append: 'px' }}; --pt: {{ custom_spacing.settings.padding_top | append: 'px' }}; --pb: {{ custom_spacing.settings.padding_bottom | append: 'px' }}; --sm-pt: {{ custom_spacing.settings.sm_padding_top | append: 'px' }}; --sm-pb: {{ custom_spacing.settings.sm_padding_bottom | append: 'px' }};"
  {%- endif %}>

  <tab-container class="tabs">
    <div class="container">
      {%- if header_block != blank -%}
        {% render 'section-header',
          size_multiplier: header_block.settings.size_multiplier,
          sm_size_multiplier: header_block.settings.sm_size_multiplier,
          text_align: header_block.settings.text_alignment,
          subtitle: header_block.settings.subtitle,
          subtitle_tag: header_block.settings.subtitle_tag,
          title: header_block.settings.title,
          title_tag: header_block.settings.title_tag,
          text: header_block.settings.text,
          shopify_attr: header_block.shopify_attributes
        %}
      {%- endif -%}
      {%- if section.settings.selector_prompt_text != blank -%}
        <p class="switcher-selector-prompt">{{ section.settings.selector_prompt_text | escape }}</p>
      {%- endif -%}
      {{ tab_titles }}
    </div>
    {{ tab_contents }}

  </tab-container>
</div>

